1109   
1110   
1111   
1112  alias (y,y2);
1113  alias (f,f2);
1114  alias (c,c2);
1115  alias (q,q2);
1116  alias (d,d2);
1117  alias (t,tprev,t2);
1118  alias (AT,AT2);
