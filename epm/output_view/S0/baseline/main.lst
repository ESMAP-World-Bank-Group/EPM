1596  * ------------------------------
1597  * Unit-commitment transition equations
1598  * ------------------------------
1599     eCommitmentConsistency 'Keeps each hour’s on/off change consistent with the recorded startup/shutdown activity'
1600     eCommitmentInitialization 'Applies the same accounting for the first chronological slot using the initial status'
1601     eCommitmentSingleTransition 'Prevents multiple start/shutdown actions within a single chronological slot'
1602     eStartupCostConstraint(g,q,d,t,y) 'Aggregate startup cost per representative timeslice'
1603     eMinUpInitial(g,y) 'Initial minimum up-time accounting'
1604     eMinUpRolling(g,AT2,y) 'Rolling minimum up-time enforcement for startups'
1605     eMinDownInitial(g,y) 'Initial minimum down-time accounting'
1606     eMinDownRolling(g,AT2,y) 'Rolling minimum down-time enforcement for shutdowns'
1607  ;
1608   
1609   
1610  *-------------------------------------------------------------------
1611  * OBJECTIVE FUNCTION
1612  *-------------------------------------------------------------------
1613  * Adding system-level cost of reserves and CO2 backstop to the total cost
1614  eNPVCost..
1615     vNPVCost =e= sum(y, pRR(y)*pWeightYear(y)*(sum(c,
1616                                   vYearlyTotalCost(c,y)) +
1617                                   vYearlyUnmetPlanningReserveCostSystem(y) +
1618                                   vYearlyUnmetSpinningReserveCostSystem(y) +
1619                                   vYearlyCO2BackstopCostSystem(y))
1620                                   );
1621   
1622  *-------------------------------------------------------------------
1623  * 1. COST
1624  *-------------------------------------------------------------------
1625  * ------------------------------
1626  * System-level Cost accounting
1627  * ------------------------------
1628   
1629  eYearlyUnmetPlanningReserveCostSystem(y)..
1630     vYearlyUnmetPlanningReserveCostSystem(y) =e= vUnmetPlanningReserveSystem(y)*pPlanningReserveVoLL;
1631   
1632  eYearlyUnmetSpinningReserveCostSystem(y)..
1633     vYearlyUnmetSpinningReserveCostSystem(y) =e= sum((q,d,t), vUnmetSpinningReserveSystem(q,d,t,y)*pHours(q,d,t)*pSpinningReserveVoLL);
1634   
1635  eYearlyCO2BackstopCostsSystem(y)..
1636     vYearlyCO2BackstopCostSystem(y) =e= vYearlySysCO2backstop(y)*pCostOfCO2backstop;
1637   
1638  * Note capex is full capex in $m per MW. Also note VarCost includes fuel cost and VOM -
1639  * essentially the short run marginal cost for the generator
1640   
1641  * Adding country-level cost of reserves and CO2 backstop to the total cost
1642  eYearlyTotalCost(c,y)..
1643     vYearlyTotalCost(c,y) =e= vYearlyUnmetReserveCostCountry(c,y)+ vYearlyCO2BackstopCostCountry(c,y)
1644                             + sum(zcmap(z,c), vAnnCapex(z, y)
1645                                             + vYearlyFOMCost(z, y)
1646                                             + vYearlyVariableCost(z,y)
1647                                             + vYearlySpinningReserveCost(z,y)
1648                                             + vYearlyUSECost(z,y)
1649                                             + vYearlyCarbonCost(z,y)
1650                                             + vYearlyExternalTradeCost(z,y)
1651                                             + vAnnualizedTransmissionCapex(z,y)
1652                                             + vYearlyCurtailmentCost(z,y)
1653                                             + vYearlySurplus(z,y));
1654   
1655  * ------------------------------
1656  * Country-level Cost accounting
1657  * ------------------------------
1658   
1659  * Yearly unmet reserve cost at the country level
1660  eYearlyUnmetReserveCostCountry(c,y)..
1661     vYearlyUnmetReserveCostCountry(c,y) =e= vYearlyUnmetPlanningReserveCostCountry(c,y) + vYearlyUnmetSpinningReserveCostCountry(c,y);
1662   
1663  * Yearly unmet spinning reserve cost at the country level
1664  eYearlyUnmetSpinningReserveCostCountry(c,y)..
1665     vYearlyUnmetSpinningReserveCostCountry(c,y) =e= sum((q,d,t), vUnmetSpinningReserveCountry(c,q,d,t,y)*pHours(q,d,t)*pSpinningReserveVoLL);
1666   
1667  * Yearly unmet planning reserve cost at the country level
1668  eYearlyUnmetPlanningReserveCostCountry(c,y)..
1669     vYearlyUnmetPlanningReserveCostCountry(c,y) =e= vUnmetPlanningReserveCountry(c,y)*pPlanningReserveVoLL;
1670   
1671  * Yearly CO2 backstop cost at the country level
1672  eYearlyCO2BackstopCostCountry(c,y)..
1673     vYearlyCO2BackstopCostCountry(c,y) =e= vYearlyCO2backstop(c,y)*pCostOfCO2backstop;
1674   
1675  * ------------------------------
1676  * Zonal CAPEX accounting
1677  * Aggregates generator-level annualized CAPEX to the zone level.
1678  * ------------------------------
1679  * Annualized CAPEX for all zones in year y
1680  eTotalAnnualizedCapex(z, y)..
1681     vAnnCapex(z,y) =e= sum(gzmap(g,z), vAnnGenCapex(g,y));
1682   
1683  * Annualized CAPEX for all generators in year y
1684  * Separate treatment keeps time-varying CAPEX trajectories (dc) distinct
1685  * from flat-cost assets (ndc) when annualizing capital costs.
1686  * Assets tagged in set dc(g) follow time-varying CAPEX trajectories (stored
1687  * in vAnnCapexGenTraj), while flat-cost assets (ndc(g)) use
1688  * conventional CRF-based annualization. We keep both paths to preserve the
1689  * different depreciation logic without double-counting.
1690  eTotalAnnualizedGenCapex(g,y)..
1691     vAnnGenCapex(g,y) =e=
1692         vAnnCapexGenTraj(g,y)$(dc(g) and ng(g))
1693       + pCRF(g)*vCap(g,y)*pGenData(g,"Capex")*1e6$(ndc(g) and ng(g))
1694       + pCRFsst(g)*vCapStor(g,y)*pStorageData(g,"CapexMWh")*1e3$(ndc(g) and ng(g) and not cs(g))
1695       + pCRFcst(g)*vCapStor(g,y)*pCSPData(g,"Storage","CapexMWh")*1e3$(ndc(g) and ng(g) and not st(g))
1696       + pCRFcth(g)*vCapTherm(g,y)*pCSPData(g,"Thermal Field","CapexMWh")*1e6$(ndc(g) and ng(g));
1697   
1698  * Annualized CAPEX accumulation (years after the start year) for generators with capex trajectory
1699  eAnnualizedCapexUpdate(dc,y)$(not sStartYear(y))..
1700     vAnnCapexGenTraj(dc,y) =e= vAnnCapexGenTraj(dc,y-1)
1701                       + vBuild(dc,y)*pGenData(dc,"Capex")*pCapexTrajectories(dc,y)*pCRF(dc)*1e6
1702                       + vBuildStor(dc,y)*pStorageData(dc,"CapexMWh")*pCapexTrajectories(dc,y)*pCRFsst(dc)*1e3
1703                       + vBuildStor(dc,y)*pCSPData(dc,"Storage","CapexMWh")*pCapexTrajectories(dc,y)*pCRFcst(dc)*1e3
1704                       + vBuildTherm(dc,y)*pCSPData(dc,"Thermal Field","CapexMWh")*pCapexTrajectories(dc,y)*pCRFcth(dc)*1e6;
1705   
1706  * Initial annualized CAPEX in the start year for generators with capex trajectory
1707  eAnnualizedCapexInit(dc,sStartYear(y))..
1708     vAnnCapexGenTraj(dc,y) =e=
1709         vBuild(dc,y)     *pGenData(dc,"Capex")        *pCapexTrajectories(dc,y)*pCRF(dc)   *1e6
1710       + vBuildStor(dc,y) *pStorageData(dc,"CapexMWh")    *pCapexTrajectories(dc,y)*pCRFsst(dc)*1e3
1711       + vBuildStor(dc,y) *pCSPData(dc,"Storage","CapexMWh")*pCapexTrajectories(dc,y)*pCRFcst(dc)*1e3
1712       + vBuildTherm(dc,y)*pCSPData(dc,"Thermal Field","CapexMWh")*pCapexTrajectories(dc,y)*pCRFcth(dc)*1e6;
1713   
1714  * FOM costs including fixed O&M costs for generators, storage, and CSP thermal field
1715  eYearlyFOMCost(z,y)..
1716     vYearlyFOMCost(z,y) =e= sum(gzmap(g,z),  vCap(g,y)*pGenData(g,"FOMperMW"))
1717              + sum(gzmap(st,z), vCapStor(st,y)*pStorageData(st,"FixedOMMWh"))
1718              + sum(gzmap(cs,z), vCapStor(cs,y)*pCSPData(cs,"Storage","FixedOMMWh"))
1719              + sum(gzmap(cs,z), vCapTherm(cs,y)*pCSPData(cs,"Thermal field","FixedOMMWh"));
1720   
1721  * Variable costs equals fuel cost plus VOM cost
1722  eYearlyVariableCost(z,y)..
1723     vYearlyVariableCost(z,y) =e= vYearlyFuelCost(z,y) + vYearlyVOMCost(z,y) + vYearlyStartupCost(z,y);
1724   
1725  * Annualized startup cost pulled from dispatch slots (links to time-sliced variable).
1726  eYearlyStartupCost(z,y)$((fDispatchMode and fApplyStartupCost))..
1727     vYearlyStartupCost(z,y) =e= sum((gzmap(g,z),q,d,t)$MinGenPoint(g),
1728           vStartupCost(g,q,d,t,y)*pHours(q,d,t));
1729   
1730  * If startup costs are disabled, force the reporting variable to zero.
1731  eYearlyStartupCostOff(z,y)$(fDispatchMode=0 or fApplyStartupCost=0)..
1732     vYearlyStartupCost(z,y) =e= 0;
1733  *  Startup cost flows through the same time-slice weighting as the rest of the variable cost stack.
1734   
1735  * Fuel costs
1736  eYearlyFuelCost(z,y)..
1737     vYearlyFuelCost(z,y) =e= sum((gzmap(g,z),f,q,d,t), pFuelCost(g,f,y)*vPwrOut(g,f,q,d,t,y)*pHours(q,d,t));
1738   
1739  * VOM
1740  eYearlyVOMCost(z,y)..
1741     vYearlyVOMCost(z,y) =e= sum((gzmap(g,z),f,q,d,t), pVOMCost(g,f,y)*vPwrOut(g,f,q,d,t,y)*pHours(q,d,t));
1742   
1743  * Note: ReserveCost is in $/MWh -- this is the DIRECT cost of holding reserve like wear and tear that a generator bids in a market
1744  eYearlySpinningReserveCost(z,y)..
1745     vYearlySpinningReserveCost(z,y) =e= sum((gzmap(g,z),q,d,t), vSpinningReserve(g,q,d,t,y)*pGenData(g,"ReserveCost")*pHours(q,d,t));
1746   
1747  * Unserved energy cost (USE)
1748  eYearlyUSECost(z,y)..
1749     vYearlyUSECost(z,y) =e= sum((q,d,t), vUSE(z,q,d,t,y)*pVoLL*pHours(q,d,t));
1750   
1751  * Surplus cost
1752  eYearlySurplusCost(z,y)..
1753     vYearlySurplus(z,y) =e= sum((q,d,t), vSurplus(z,q,d,t,y)*pSurplusPenalty*pHours(q,d,t));
1754   
1755  * Curtailment cost
1756  eYearlyCurtailmentCost(z,y)..
1757     vYearlyCurtailmentCost(z,y) =e= sum((gzmap(g,z),q,d,t), vCurtailedVRE(z,g,q,d,t,y)*pCostOfCurtailment*pHours(q,d,t));
1758   
1759  * Yearly trade cost
1760  eYearlyExternalTradeCost(z,y)..
1761     vYearlyExternalTradeCost(z,y) =e= vYearlyImportExternalCost(z,y) - vYearlyExportExternalCost(z,y);
1762   
1763  * Yearly import and export costs from external zones
1764  eYearlyImportExternalCost(z,y)..
1765     vYearlyImportExternalCost(z,y) =e= sum((zext,q,d,t), vYearlyImportExternal(z,zext,q,d,t,y)*pTradePrice(zext,q,d,y,t)*pHours(q,d,t));
1766   
1767  * Yearly export cost to external zones
1768  eYearlyExportExternalCost(z,y)..
1769     vYearlyExportExternalCost(z,y) =e= sum((zext,q,d,t), vYearlyExportExternal(z,zext,q,d,t,y)*pTradePrice(zext,q,d,y,t)*pHours(q,d,t));
1770   
1771  * Yearly CO2 emissions cost for each zone
1772  eYearlyCarbonCost(z,y)..
1773     vYearlyCarbonCost(z,y) =e= fEnableCarbonPrice*pCarbonPrice(y)
1774                              * Sum((gzmap(g,z),gfmap(g,f),q,d,t), vPwrOut(g,f,q,d,t,y)*pHeatRate(g,f)*pFuelCarbonContent(f)*pHours(q,d,t));
1775   
1776   
1777  * Ensures that when accessing parameters like CostPerLine or Life for a connection between zones i and j,
1778  * the model always uses the maximum of both directions, regardless of ordering.
1779  $macro symmax(s,i,j,h) max(s(i,j,h),s(j,i,h))
1780   
1781  * Computes annualized investment cost of new transmission lines connected to zone z
1782  * using the annuity formula and averaging (divided by 2) to avoid double-counting symmetric lines
1783  eAnnualizedTransmissionCapex(z,y)$(fAllowTransferExpansion and sum(sTopology(z,z2),1))..
1784     vAnnualizedTransmissionCapex(z,y) =e=
1785         sum(sTopology(z,z2),
1786             vNewTransmissionLine(z,z2,y)
1787           * max(pNewTransmission(z,z2,"CostPerLine"),pNewTransmission(z2,z,"CostPerLine"))
1788           * 1e6)
1789       / 2
1790       * (pWACC / (1 - (1 / ((1 + pWACC) ** sum(sTopology(z,z2), max(pNewTransmission(z,z2,"Life"),pNewTransmission(z2,z,"Life")))))));
1791   
1792  * ------------------------------
1793  * Demand and supply balance
1794  * Ensures zonal demand matches supply components.
1795  * ------------------------------
1796  eDemSupply(z,q,d,t,y)$FD(q,d,t)..
1797     pDemandData(z,q,d,y,t) * pEnergyEfficiencyFactor(z,y) =e= vSupply(z,q,d,t,y);
1798   
1799  eDefineSupply(z,q,d,t,y)$FD(q,d,t)..
1800     vSupply(z,q,d,t,y) =e=
1801       sum((gzmap(g,z),gfmap(g,f)), vPwrOut(g,f,q,d,t,y))
1802     - sum(sTopology(z,z2), vFlow(z,z2,q,d,t,y))
1803     + sum(sTopology(z,z2), vFlow(z2,z,q,d,t,y) * (1 - pLossFactorInternal(z,z2,y)))
1804     - sum(gzmap(st,z), vStorInj(st,q,d,t,y))$(fEnableStorage)
1805     + sum(zext, vYearlyImportExternal(z,zext,q,d,t,y))
1806     - sum(zext, vYearlyExportExternal(z,zext,q,d,t,y))
1807     + vUSE(z,q,d,t,y)
1808     - vSurplus(z,q,d,t,y);
1809   
1810   
1811  * ------------------------------
1812  * Generator capacity equations
1813  * Tracks installed capacity for existing/new units.
1814  * ------------------------------
1815  * Initial capacity balance in the first model year
1816  eInitialCapacity(g,sStartYear(y))..
1817     vCap(g,y) =e= pGenData(g,"Capacity")$(eg(g) and (pGenData(g,"StYr") <= sStartYear.val))
1818                 + vBuild(g,y) - vRetire(g,y);
1819   
1820  * Year-on-year capacity tracking for existing generators
1821  eCapacityEvolutionExist(eg,y)$(not sStartYear(y))..
1822     vCap(eg,y) =e= vCap(eg,y-1) + vBuild(eg,y) - vRetire(eg,y);
1823   
1824  * Year-on-year capacity tracking for new generators (non-retirable)
1825  eCapacityEvolutionNew(ng,y)$(not sStartYear(y))..
1826     vCap(ng,y) =e= vCap(ng,y-1) + vBuild(ng,y);
1827   
1828  * Limit on initial build for new generators (starting after model year 1)
1829  eInitialBuildLimit(eg)$(pGenData(eg,"StYr") > sStartYear.val)..
1830     sum(y, vBuild(eg,y)) =l= pGenData(eg,"Capacity");
1831   
1832  eMinGenRE(c,y)$(pMinRE and y.val >= pMinsRenewableTargetYear)..
1833     sum((zcmap(z,c),gzmap(RE,z),gfmap(RE,f),q,d,t), vPwrOut(RE,f,q,d,t,y)*pHours(q,d,t)) =g=
1834     sum((zcmap(z,c),q,d,t), pDemandData(z,q,d,y,t)*pHours(q,d,t)*pEnergyEfficiencyFactor(z,y))*pMinRE;
1835   
1836  eBuiltCap(ng,y)$pGenData(ng,"DescreteCap")..
1837     vBuild(ng,y) =e= pGenData(ng,"UnitSize")*vBuiltCapVar(ng,y);
1838   
1839  eRetireCap(eg,y)$(pGenData(eg,"DescreteCap") and (y.val <= pGenData(eg,"RetrYr")))..
1840     vRetire(eg,y) =e= pGenData(eg,"UnitSize")*vRetireCapVar(eg,y);
1841   
1842  * ------------------------------
1843  * Production equations
1844  * Constrains generator dispatch, ramping, and minimum output.
1845  * ------------------------------
1846  * Enforces dispatch/reserve only when the generator is committed for the chronological slot.
1847  eJointResCap(g,q,d,t,y)$FD(q,d,t)..
1848     sum(gfmap(g,f), vPwrOut(g,f,q,d,t,y)) + vSpinningReserve(g,q,d,t,y)
1849        =l= vCap(g,y)*(1+pGenData(g,"Overloadfactor"));
1850   
1851  eMaxCF(g,q,y)..
1852     sum((gfmap(g,f),d,t), vPwrOut(g,f,q,d,t,y)*pHours(q,d,t)) =l= pAvailability(g,y,q)*vCap(g,y)*sum((d,t), pHours(q,d,t));
1853   
1854  * Note that we are effectively assuming grid-connected RE generation to be dispatchable. Generally speaking, most RE will be
1855  * dispatched anyway because they have zero cost (i.e., not a different outcome from net load approach, but this allows for
1856  * RE generation to be rejected as well
1857  eVREProfile(gfmap(VRE,f),z,q,d,t,y)$(gzmap(VRE,z) and FD(q,d,t))..
1858     vPwrOut(VRE,f,q,d,t,y) + vCurtailedVRE(z,VRE,q,d,t,y) =e= pVREgenProfile(VRE,q,d,t)*pAvailability(VRE,y,q)*vCap(VRE,y);
1859   
1860  eFuel(zfmap(z,f),y)..
1861     vFuel(z,f,y) =e= sum((gzmap(g,z),gfmap(g,f),q,d,t), vPwrOut(g,f,q,d,t,y)*pHours(q,d,t)*pHeatRate(g,f));
1862   
1863  eFuelLimit(c,f,y)$(fApplyFuelConstraint and pMaxFuelLimit(c,f,y) > 0)..
1864     sum((zcmap(z,c),zfmap(z,f)), vFuel(z,f,y)) =l= pMaxFuelLimit(c,f,y)*1e6;
1865   
1866  * Phase-out constraint: limits annual generation by zone-technology-fuel combination
1867  eMaxGenerationByFuel(z,tech,f,y)$(fApplyGenerationPhaseout and pMaxGenerationByFuel(z,tech,f,y))..
1868     sum((gzmap(g,z),gtechmap(g,tech),gfmap(g,f),q,d,t), vPwrOut(g,f,q,d,t,y)*pHours(q,d,t))/1e3 =l= pMaxGenerationByFuel(z,tech,f,y);
1869   
1870  * Applies the minimum output requirement per capacity share.
1871  eMinGen(g,q,d,t,y)$((fApplyMinGenShareAllHours and pGenData(g,"MinGenShareAllHours") > 0) and FD(q,d,t))..
1872      sum(gfmap(g,f), vPwrOut(g,f,q,d,t,y)) =g= vCap(g,y)*pGenData(g,"MinGenShareAllHours");
1873   
1874  * ------------------------------
1875  * Unit-commitment transition equations
1876  * Ensures the recorded on/off state matches startups/shutdowns and forbids more than one transition per slot.
1877  * Since the state alone cannot capture how many switches occurred, we introduce startup/shutdown binaries alongside `isOn`.
1878  * ------------------------------
1879   
1880  * Dispatch-mode minimum generation only when the generator is recorded as online.
1881  eDispatchMinGenPoint(g,q,d,t,y)$((fDispatchMode and fApplyMinGenCommitment and MinGenPoint(g) and FD(q,d,t)))..
1882     sum(gfmap(g,f), vPwrOut(g,f,q,d,t,y))
1883        =g= pGenData(g,"MinGenCommitment")*pGenData(g,"Capacity")
1884            * sum(AT$mapTS(q,d,t,AT), isOn(g,q,d,t,AT,y));
1885   
1886  * Prevents exceeding capacity while the generator reports being online in dispatch slots.
1887  eDispatchMaxGenPoint(g,q,d,t,y)$((fDispatchMode and fApplyMinGenCommitment and MinGenPoint(g) and FD(q,d,t)))..
1888     sum(gfmap(g,f), vPwrOut(g,f,q,d,t,y))
1889        =l= pGenData(g,"Capacity")*sum(AT$mapTS(q,d,t,AT), isOn(g,q,d,t,AT,y));
1890   
1891  * Keeps each hour’s on/off change consistent with the recorded startup/shutdown activity.
1892  eCommitmentConsistency(g,AT,y)$(ord(AT) > 1 and fDispatchMode and fApplyMinGenCommitment and MinGenPoint(g))..
1893     sum((q,d,t)$mapTS(q,d,t,AT), isStartup(g,q,d,t,AT,y) - isShutdown(g,q,d,t,AT,y))
1894        =e= sum((q,d,t)$mapTS(q,d,t,AT), isOn(g,q,d,t,AT,y))
1895           - sum((q,d,t)$mapTS(q,d,t,AT-1), isOn(g,q,d,t,AT-1,y));
1896   
1897  * Applies the same accounting for the first chronological slot using the initial status.
1898  eCommitmentInitialization(g,AT,y)$(ord(AT) = 1 and fDispatchMode and fApplyMinGenCommitment and MinGenPoint(g))..
1899     sum((q,d,t)$mapTS(q,d,t,AT), isStartup(g,q,d,t,AT,y) - isShutdown(g,q,d,t,AT,y))
1900        =e= sum((q,d,t)$mapTS(q,d,t,AT), isOn(g,q,d,t,AT,y)) - pInitialOnStart(g);
1901   
1902  * Prevents multiple start/shutdown actions within a single chronological slot.
1903  eCommitmentSingleTransition(g,AT,y)$(fDispatchMode and fApplyMinGenCommitment and MinGenPoint(g))..
1904     sum((q,d,t)$mapTS(q,d,t,AT), isStartup(g,q,d,t,AT,y) + isShutdown(g,q,d,t,AT,y)) =l= 1;
1905   
1906  * ------------------------------
1907  * Minimum up/down-time constraints
1908  * ------------------------------
1909  * Initial minimum up-time: if HoursOn > 0, force the remaining required online hours.
1910  eMinUpInitial(g,y)$(fDispatchMode and fApplyMUDT and fApplyMinGenCommitment and MinGenPoint(g) and pGenData(g,"HoursOn")
1911        and pGenData(g,"HoursOff") = 0 and pGenData(g,"minUT") > 0.999)..
1912     sum(AT$(ord(AT) < (pGenData(g,"minUT") - pGenData(g,"HoursOn") + 1)),
1913         sum((q,d,t)$mapTS(q,d,t,AT), 1 - isOn(g,q,d,t,AT,y))) =e= 0;
1914   
1915  * Rolling minimum up-time: every startup must be followed by minUT consecutive on hours.
1916  eMinUpRolling(g,AT2,y)$(fDispatchMode and fApplyMUDT and fApplyMinGenCommitment and MinGenPoint(g) and pGenData(g,"minUT") > 0.999
1917        and ord(AT2) > (pGenData(g,"minUT") - pGenData(g,"HoursOn") + 1)$pGenData(g,"HoursOn")
1918        and ord(AT2) < (card(AT2) - pGenData(g,"minUT") + 1))..
1919     sum(AT$((ord(AT) >= ord(AT2)) and (ord(AT) < ord(AT2) + pGenData(g,"minUT"))),
1920         sum((q,d,t)$mapTS(q,d,t,AT), isOn(g,q,d,t,AT,y)))
1921        =g= pGenData(g,"minUT") * sum((q,d,t)$mapTS(q,d,t,AT2), isStartup(g,q,d,t,AT2,y));
1922   
1923  * Initial minimum down-time: if HoursOff > 0, force the remaining offline hours.
1924  eMinDownInitial(g,y)$(fDispatchMode and fApplyMUDT and fApplyMinGenCommitment and MinGenPoint(g) and pGenData(g,"HoursOn") = 0
1925        and pGenData(g,"HoursOff") and pGenData(g,"minDT") > 0.999)..
1926     sum(AT$(ord(AT) < (pGenData(g,"minDT") - pGenData(g,"HoursOff") + 1)),
1927         sum((q,d,t)$mapTS(q,d,t,AT), isOn(g,q,d,t,AT,y))) =e= 0;
1928   
1929  * Rolling minimum down-time: every shutdown must be followed by minDT consecutive off hours.
1930  eMinDownRolling(g,AT2,y)$(fDispatchMode and fApplyMUDT and fApplyMinGenCommitment and MinGenPoint(g) and pGenData(g,"minDT") > 0.999
1931        and ord(AT2) > (pGenData(g,"minDT") - pGenData(g,"HoursOff") + 1)$pGenData(g,"HoursOff")
1932        and ord(AT2) < (card(AT2) - pGenData(g,"minDT") + 1))..
1933     sum(AT$((ord(AT) >= ord(AT2)) and (ord(AT) < ord(AT2) + pGenData(g,"minDT"))),
1934         sum((q,d,t)$mapTS(q,d,t,AT), 1 - isOn(g,q,d,t,AT,y)))
1935        =g= pGenData(g,"minDT") * sum((q,d,t)$mapTS(q,d,t,AT2), isShutdown(g,q,d,t,AT2,y));
1936   
1937  * ------------------------------
1938  * Startup-cost translation
1939  * ------------------------------
1940  * Aggregate startup events per representative bucket by summing every chronological `AT` slot that belongs to (q,d,t).
1941  * The resulting cost is tied to the time slice so the variable-cost stack can weight it just like fuel and VOM.
1942  eStartupCostConstraint(g,q,d,t,y)$((fDispatchMode and fApplyMinGenCommitment and MinGenPoint(g) and fApplyStartupCost and FD(q,d,t)))..
1943     vStartupCost(g,q,d,t,y) =e= sum(AT$mapTS(q,d,t,AT), isStartup(g,q,d,t,AT,y)) * pGenData(g,"StUpCost");
1944   
1945  * ------------------------------
1946  * Dispatch-level ramping continuity
1947  * ------------------------------
1948   
1949  eRampDnLimit(g,q,d,t,y)$((Ramprate(g) and not sFirstHour(t) and fApplyRampConstraint and fDispatchMode=0) and FD(q,d,t))..
1950     sum(gfmap(g,f), vPwrOut(g,f,q,d,t-1,y)) - sum(gfmap(g,f), vPwrOut(g,f,q,d,t,y)) =l= vCap(g,y)*pGenData(g,"RampDnRate");
1951   
1952  eRampUpLimit(g,q,d,t,y)$((Ramprate(g) and not sFirstHour(t) and fApplyRampConstraint and fDispatchMode=0) and FD(q,d,t))..
1953     sum(gfmap(g,f), vPwrOut(g,f,q,d,t,y)) - sum(gfmap(g,f), vPwrOut(g,f,q,d,t-1,y)) =l= vCap(g,y)*pGenData(g,"RampUpRate");
1954   
1955  * Tie the chronological slot totals to the underlying hourly dispatch so that ramp limits can aggregate across AT.
1956  eRampContinuity(g,q,d,t,AT,y)$((Ramprate(g) and fApplyRampConstraint and fDispatchMode) and mapTS(q,d,t,AT))..
1957     sum(gfmap(g,f), vPwrOut(g,f,q,d,t,y)) =e= vPwrOutDispatch(g,q,d,t,AT,y);
1958   
1959  * Ensure ramp-up across consecutive AT slots respects the ramp rate plus any additional headroom from startups when min-gen constraints are active.
1960  eDispatchRampUpLimit(g,AT,y)$((not sFirstHourAT(AT) and Ramprate(g) and fApplyRampConstraint and fDispatchMode))..
1961     sum((q,d,t)$mapTS(q,d,t,AT), vPwrOutDispatch(g,q,d,t,AT,y))
1962     - sum((q,d,t)$mapTS(q,d,t,AT-1), vPwrOutDispatch(g,q,d,t,AT-1,y))
1963            =l= sum((q,d,t)$mapTS(q,d,t,AT), isStartup(g,q,d,t,AT,y))*pGenData(g,"Capacity")$(fApplyMinGenCommitment and MinGenPoint(g))
1964            + vCap(g,y)*pGenData(g,"RampUpRate");
1965   
1966  * Ensure ramp-down across slots respects ramp-down rates while allowing shutdowns to absorb faster decreases.
1967  eDispatchRampDownLimit(g,AT,y)$((not sFirstHourAT(AT) and Ramprate(g) and fApplyRampConstraint and fDispatchMode))..
1968     sum((q,d,t)$mapTS(q,d,t,AT-1), vPwrOutDispatch(g,q,d,t,AT-1,y))
1969     - sum((q,d,t)$mapTS(q,d,t,AT), vPwrOutDispatch(g,q,d,t,AT,y))
1970            =l= sum((q,d,t)$mapTS(q,d,t,AT), isShutdown(g,q,d,t,AT,y))*pGenData(g,"Capacity")$(fApplyMinGenCommitment and MinGenPoint(g))
1971            + vCap(g,y)*pGenData(g,"RampDnRate");
1972   
1973  * ------------------------------
1974  * Reserve equations
1975  * Enforces spinning and planning reserve requirements.
1976  * ------------------------------
1977  * Spinning reserve limit as a share of capacity
1978  eSpinningReserveLim(g,q,d,t,y)$((fApplyCountrySpinReserveConstraint or fApplySystemSpinReserveConstraint) and FD(q,d,t))..
1979     vSpinningReserve(g,q,d,t,y) =l= vCap(g,y)*pGenData(g,"ResLimShare");
1980   
1981  * Spinning reserve limit for VRE as a share of capacity adjusted for production profile
1982  eSpinningReserveLimVRE(gfmap(VRE,f),q,d,t,y)$((fApplyCountrySpinReserveConstraint or fApplySystemSpinReserveConstraint) and FD(q,d,t))..
1983      vSpinningReserve(VRE,q,d,t,y) =l= vCap(VRE,y)*pGenData(VRE,"ResLimShare")* pVREgenProfile(VRE,q,d,t);
1984   
1985  * This constraint increases solving time x3
1986  * Reserve constraints include interconnections as reserves too
1987  eSpinningReserveReqCountry(c,q,d,t,y)$((fApplyCountrySpinReserveConstraint) and FD(q,d,t))..
1988     sum((zcmap(z,c),gzmap(g,z)),vSpinningReserve(g,q,d,t,y))
1989   + vUnmetSpinningReserveCountry(c,q,d,t,y)
1990  * + sIntercoReserveContributionPct * sum((zcmap(z,c),sMapConnectedZonesDiffCountries(z2,z)), pTransferLimit(z2,z,q,y)
1991  *                                        + vNewTransmissionLine(z2,z,y)*symmax(pNewTransmission,z,z2,"CapacityPerLine")*fAllowTransferExpansion
1992  *                                        - vFlow(z2,z,q,d,t,y))
1993     =g= pSpinningReserveReqCountry(c,y) + sum((zcmap(z,c),gzmap(VRE_noROR,z),gfmap(VRE_noROR,f)), vPwrOut(VRE_noROR,f,q,d,t,y))*psVREForecastErrorPct;
1994   
1995  * System spinning reserve requirement
1996  eSpinningReserveReqSystem(q,d,t,y)$((fApplySystemSpinReserveConstraint) and FD(q,d,t))..
1997     sum(g, vSpinningReserve(g,q,d,t,y)) + vUnmetSpinningReserveSystem(q,d,t,y) =g= pSpinningReserveReqSystem(y) + sum(gfmap(VRE_noROR,f), vPwrOut(VRE_noROR,f,q,d,t,y))*psVREForecastErrorPct;
1998   
1999  * Planning reserve requirement at the country level
2000  ePlanningReserveReqCountry(c,y)$(fApplyPlanningReserveConstraint and pPlanningReserveMargin(c))..
2001     sum((zcmap(z,c),gzmap(g,z)), vCap(g,y)*pCapacityCredit(g,y))
2002   + vUnmetPlanningReserveCountry(c,y)
2003   + (sum((zcmap(z,c),sMapConnectedZonesDiffCountries(z2,z)), sum(q,pTransferLimit(z2,z,q,y))/card(q) + vNewTransmissionLine(z2,z,y)*max(pNewTransmission(z,z2,"CapacityPerLine"),pNewTransmission(z2,z,"CapacityPerLine"))*fAllowTransferExpansion))$fCountIntercoForReserves
2004     =g= (1+pPlanningReserveMargin(c))*smax((q,d,t), sum(zcmap(z,c), pDemandData(z,q,d,y,t)*pEnergyEfficiencyFactor(z,y)));
2005   
2006  * Planning reserve requirement at the system level
2007  ePlanningReserveReqSystem(y)$(fApplyPlanningReserveConstraint and sReserveMarginPct)..
2008     sum(g, vCap(g,y)*pCapacityCredit(g,y)) + vUnmetPlanningReserveSystem(y)
2009     =g= (1+sReserveMarginPct)*smax((q,d,t), sum(z, pDemandData(z,q,d,y,t)*pEnergyEfficiencyFactor(z,y)));
2010   
2011   
2012  * ------------------------------
2013  * Transfer equations
2014  * Limits internal flows and applies trade caps.
2015  * ------------------------------
2016  * Limits flow between zones to existing + expandable transmission capacity
2017  eTransferCapacityLimit(sTopology(z,z2),q,d,t,y)$FD(q,d,t)..
2018     vFlow(z,z2,q,d,t,y) =l= pTransferLimit(z,z2,q,y) + vNewTransmissionLine(z,z2,y)*max(pNewTransmission(z,z2,"CapacityPerLine"),pNewTransmission(z2,z,"CapacityPerLine"))*fAllowTransferExpansion;
2019   
2020  * Enforces minimum import flow into a zone when specified
2021  eMinImportRequirement(sTopology(z,z2),q,d,t,y)$(pMinImport(z2,z,y) and FD(q,d,t))..
2022     vFlow(z2,z,q,d,t,y) =g= pMinImport(z2,z,y);
2023   
2024  * --- Contracted transfer volumes, inactive unless explicitly switched on ------
2025  * Disabled by default (fApplyContractedTrade = 0) and generating no rows at all
2026  * when off, so models that do not set it behave exactly as before.
2027  *
2028  * Fixes the seasonal energy delivered on a contracted corridor from
2029  * sContractedTradeFirstYear onwards, for corridors under a power purchase
2030  * agreement whose volume is set by contract rather than by the optimiser.
2031  * Membership is carried by pContractedTradeFlag and not by pContractedTradeEnergy
2032  * being non-zero: a zero in the CSV is read as missing, which would silently drop
2033  * exactly the (corridor, season) pairs meant to be held at zero flow.
2034  * The season is data, not a hard-coded set, so the same equation serves contracts
2035  * written on any season, including one covering the whole year.
2036  *
2037  * Mode 1, exact volume: a flagged pair with no volume is held at zero flow, which
2038  * also suppresses counter-flows on contracted corridors.
2039  eContractedSeasonalTransfer(sTopology(z,z2),q,y)$(fApplyContractedTrade = 1
2040                                                    and pContractedTradeFlag(z,z2,q)
2041                                                    and y.val >= sContractedTradeFirstYear)..
2042     sum((d,t), vFlow(z,z2,q,d,t,y)*pHours(q,d,t)) =e= pContractedTradeEnergy(z,z2,q,y)*1e3;
2043   
2044  * Mode 2, take-or-pay floor: the corridor delivers at least the contracted volume
2045  * and the optimiser is free to send more.
2046  * Both modes are hard constraints, like eMinImportRequirement above: a contracted
2047  * volume the corridor cannot physically carry makes the model infeasible rather
2048  * than reporting a shortfall.
2049  eContractedSeasonalTransferMin(sTopology(z,z2),q,y)$(fApplyContractedTrade = 2
2050                                                       and pContractedTradeFlag(z,z2,q)
2051                                                       and y.val >= sContractedTradeFirstYear)..
2052     sum((d,t), vFlow(z,z2,q,d,t,y)*pHours(q,d,t)) =g= pContractedTradeEnergy(z,z2,q,y)*1e3;
2053   
2054  * Cumulative build-out of new transfer capacity over time
2055  eCumulativeTransferExpansion(sTopology(z,z2),y)$fAllowTransferExpansion..
2056     vNewTransmissionLine(z,z2,y) =e=  vNewTransmissionLine(z,z2,y-1) + vBuildTransmissionLine(z,z2,y);
2057   
2058  * Ensures symmetry in bidirectional transmission investment
2059  eSymmetricTransferBuild(sTopology(z,z2),y)$fAllowTransferExpansion..
2060     vBuildTransmissionLine(z,z2,y)  =e=  vBuildTransmissionLine(z2,z,y);
2061   
2062  * External trade
2063   
2064  * Caps total import energy based on annual demand and max external trade share
2065  eMaxAnnualImportShareEnergy(c,y)$fEnableExternalExchange..
2066     sum((zcmap(z,c),zext,q,d,t), vYearlyImportExternal(z,zext,q,d,t,y)*pHours(q,d,t)) =l=
2067     sum((zcmap(z,c),q,d,t), pDemandData(z,q,d,y,t)*pHours(q,d,t)*pEnergyEfficiencyFactor(z,y))*pMaxAnnualExternalTradeShare(y,c);
2068   
2069  * Caps total export energy based on annual demand and max external trade share
2070  eMaxAnnualExportShareEnergy(c,y)$fEnableExternalExchange..
2071     sum((zcmap(z,c),zext,q,d,t), vYearlyExportExternal(z,zext,q,d,t,y)*pHours(q,d,t)) =l=
2072     sum((zcmap(z,c),q,d,t), pDemandData(z,q,d,y,t)*pHours(q,d,t)*pEnergyEfficiencyFactor(z,y))*pMaxAnnualExternalTradeShare(y,c);
2073   
2074  * Limits hourly import energy as a share of hourly demand
2075  eMaxHourlyImportShareEnergy(c,q,d,t,y)$((sMaxHourlyImportExternalShare<1 and fEnableExternalExchange) and FD(q,d,t))..
2076     sum((zcmap(z,c), zext), vYearlyImportExternal(z,zext,q,d,t,y))  =l= sum(zcmap(z,c), pDemandData(z,q,d,y,t)*sMaxHourlyImportExternalShare * pEnergyEfficiencyFactor(z,y));
2077   
2078  * Limits hourly export energy as a share of hourly demand
2079  eMaxHourlyExportShareEnergy(c,q,d,t,y)$((sMaxHourlyExportExternalShare<1 and fEnableExternalExchange) and FD(q,d,t))..
2080     sum((zcmap(z,c), zext),vYearlyExportExternal(z,zext,q,d,t,y)) =l= sum(zcmap(z,c), pDemandData(z,q,d,y,t)*sMaxHourlyExportExternalShare * pEnergyEfficiencyFactor(z,y));
2081   
2082  * Caps import volume from an external zone to internal zone
2083  eExternalImportLimit(z,zext,q,d,t,y)$((fEnableExternalExchange) and FD(q,d,t))..
2084     vYearlyImportExternal(z,zext,q,d,t,y)=l= pExtTransferLimitIn(z,zext,q,y);
2085   
2086  * Caps export volume from internal zone to an external zone
2087  eExternalExportLimit(z,zext,q,d,t,y)$((fEnableExternalExchange) and FD(q,d,t))..
2088     vYearlyExportExternal(z,zext,q,d,t,y)=l= pExtTransferLimitOut(z,zext,q,y);
2089   
2090  * ------------------------------
2091  * Storage operations
2092  * Controls storage SOC, charging, and reserve support.
2093  * ------------------------------
2094  * Limits state of charge (SOC) by capacity
2095  eSOCUpperBound(st,q,d,t,y)$(fEnableStorage and FD(q,d,t))..
2096     vStorage(st,q,d,t,y) =l= vCapStor(st,y);
2097   
2098  * Prevents storage being used to meet reserves only
2099  eStorageCapMinConstraint(st,q,d,t,y)$(fEnableStorage and FD(q,d,t))..
2100     vCapStor(st,y) =g= vCap(st,y);
2101   
2102  * Enforces fixed storage duration when StorageDuration parameter is specified
2103  eStorageFixedDuration(st,y)$(fEnableStorage and pStorageData(st,"StorageDuration"))..
2104     vCapStor(st,y) =e= vCap(st,y) * pStorageData(st,"StorageDuration");
2105   
2106  * Charging power ≤ power capacity
2107  eChargeCapacityLimit(st,q,d,t,y)$(fEnableStorage and FD(q,d,t))..
2108     vStorInj(st,q,d,t,y) =l= vCap(st,y);
2109   
2110  * Charge cap from PV-following storage logic
2111  eChargeLimitWithPVProfile(stp,q,d,t,y)$(fEnableStorage and FD(q,d,t))..
2112     vStorInj(stp,q,d,t,y) =l= sum(gsmap(so,stp), vCap(so,y)*pStoPVProfile(so,q,d,t));
2113   
2114  * Max rate of charge decrease (ramp-down)
2115  eChargeRampDownLimit(st,q,d,t,y)$((not sFirstHour(t) and fEnableStorage and fApplyRampConstraint) and FD(q,d,t))..
2116     vStorInj(st,q,d,t-1,y) - vStorInj(st,q,d,t,y) =l= pGenData(st,'RampDnRate')*vCap(st,y);
2117   
2118  * Max rate of charge increase (ramp-up)
2119  eChargeRampUpLimit(st,q,d,t,y)$((not sFirstHour(t) and fEnableStorage and fApplyRampConstraint) and FD(q,d,t))..
2120     vStorInj(st,q,d,t,y) - vStorInj(st,q,d,t-1,y) =l= pGenData(st,'RampUpRate')*vCap(st,y);
2121   
2122  * Defines net charge as output - input
2123  eNetChargeBalance(st,q,d,t,y)$(fEnableStorage and FD(q,d,t))..
2124     vStorNet(st,q,d,t,y) =e= sum(gfmap(st,f), vPwrOut(st,f,q,d,t,y)) - vStorInj(st,q,d,t,y);
2125   
2126  * Anchors the first hour of the representative-day cycle to the configured capacity share (dispatch mode only).
2127  eStorageSOCInitDispatch(st,g,q,d,t,y)$((fDispatchMode and sFirstHour(t) and sFirstDay(d) and fEnableStorage) and FD(q,d,t))..
2128     vStorage(st,q,d,t,y) =e= vCapStor(st,y)*pStorageInitShare;
2129   
2130  * Forces the last hour of the cycle to return to the same capacity share, ensuring the wrap-around matches the initial value (dispatch mode only).
2131  eStorageSOCFinalDispatch(st,q,d,t,y)$((fDispatchMode and sLastHour(t) and sLastDay(d) and fEnableStorage) and FD(q,d,t))..
2132     vStorage(st,q,d,t,y) =e= vCapStor(st,y)*pStorageInitShare;
2133   
2134  * Representative-day mode: enforce SOC recursion on the first hour without cross-day anchoring.
2135  eStateOfChargeInitRep(st,q,d,t,y)$((not fDispatchMode) and fEnableStorage and sFirstHour(t) and FD(q,d,t))..
2136     vStorage(st,q,d,t,y) =e= pStorageData(st,"Efficiency")*vStorInj(st,q,d,t,y) - sum(gfmap(st,f), vPwrOut(st,f,q,d,t,y));
2137   
2138  * eStorageHourTransition rolls storage state forward using the previous chronological hour (t-1), assuming storage is enabled.
2139  eStorageHourTransition(st,q,d,t,y)$((not sFirstHour(t) and fEnableStorage) and FD(q,d,t))..
2140     vStorage(st,q,d,t,y) =e= vStorage(st,q,d,t-1,y)
2141        + pStorageData(st,"Efficiency")*vStorInj(st,q,d,t,y)
2142        - sum(gfmap(st,f), vPwrOut(st,f,q,d,t,y));
2143   
2144  * Dispatch mode: wrap the first hour of each day to the previous chronological hour (AT-1); no wrap in representative-day mode.
2145  eStorageDayWrap(st,q,d,t,AT,y)$((fDispatchMode and fEnableStorage and sFirstHour(t) and mapTS(q,d,t,AT) and ord(AT) > 1) and FD(q,d,t))..
2146     vStorage(st,q,d,t,y) =e= sum((q2,d2,t2)$mapTS(q2,d2,t2,AT-1), vStorage(st,q2,d2,t2,y))
2147        + pStorageData(st,"Efficiency")*vStorInj(st,q,d,t,y)
2148        - sum(gfmap(st,f), vPwrOut(st,f,q,d,t,y));
2149   
2150  * Ensures SOC level can cover spinning reserve
2151  eSOCSupportsReserve(st,q,d,t,y)$((fEnableStorage) and FD(q,d,t))..
2152     vSpinningReserve(st,q,d,t,y) =l= vStorage(st,q,d,t,y);
2153   
2154  * In dispatch mode, the day-wrap constraint ties each day’s first hour to AT-1, preventing artificial SOC jumps.
2155  * In representative-day mode the wrap is skipped, avoiding cross-day links that do not exist in that chronology.
2156   
2157  * Ensures energy conservation over the full representative day: total input × efficiency = total output
2158  * eDailyStorageEnergyBalance(st,q,d,y)$(fEnableStorage)..
2159  *   pStorageData(st,"efficiency") * sum(t, vStorInj(st,q,d,t,y)) =e= sum((gfmap(st,f),t), vPwrOut(st,f,q,d,t,y));
2160   
2161  * ------------------------------
2162  * CSP-specific equations
2163  * Constrains CSP thermal and storage operations.
2164  * ------------------------------
2165   
2166  * Limits CSP storage level to installed storage capacity.
2167  eCSPStorageCapacityLimit(cs,q,d,t,y)$(fEnableCSP and FD(q,d,t))..
2168     vStorage(cs,q,d,t,y) =l= vCapStor(cs,y);
2169   
2170  * Limits CSP storage injection to thermal energy output * efficiency. Prevents unrealistic injection behavior.
2171  eCSPStorageInjectionLimit(cs,q,d,t,y)$(fEnableCSP and FD(q,d,t))..
2172     vStorInj(cs,q,d,t,y) =l= vThermalOut(cs,q,d,t,y)*pCSPData(cs,"Thermal Field","Efficiency");
2173   
2174  * Prevents CSP storage injection exceeding installed capacity.
2175  eCSPStorageInjectionCap(cs,q,d,t,y)$(fEnableCSP and FD(q,d,t))..
2176     vStorInj(cs,q,d,t,y) =l= vCapStor(cs,y);
2177   
2178  *Limits thermal energy output to installed thermal field capacity * hourly solar profile.
2179  eCSPThermalOutputLimit(cs,q,d,t,y)$(fEnableCSP and FD(q,d,t))..
2180     vThermalOut(cs,q,d,t,y) =l= vCapTherm(cs,y)*pCSPProfile(cs,q,d,t);
2181   
2182  * Balances CSP thermal output, storage in/out, and generator dispatch.
2183  eCSPPowerBalance(cs,q,d,t,y)$(fEnableCSP and FD(q,d,t))..
2184     vThermalOut(cs,q,d,t,y)*pCSPData(cs,"Thermal Field","Efficiency")
2185   - vStorInj(cs,q,d,t,y) + vStorOut(cs,q,d,t,y)*pCSPData(cs,"Storage","Efficiency")
2186     =e= sum(gfmap(cs,f), vPwrOut(cs,f,q,d,t,y));
2187   
2188  * Tracks CSP storage state of charge across time (except for first hour).
2189  eCSPStorageEnergyBalance(cs,q,d,t,y)$((not sFirstHour(t) and fEnableCSP) and FD(q,d,t))..
2190     vStorage(cs,q,d,t,y) =e= vStorage(cs,q,d,t-1,y) + vStorInj(cs,q,d,t,y) - vStorOut(cs,q,d,t,y);
2191   
2192  * Initializes CSP storage balance for the first hour of the day.
2193  eCSPStorageInitialBalance(cs,q,d,sFirstHour(t),y)$((fEnableCSP) and FD(q,d,t))..
2194     vStorage(cs,q,d,t,y) =e= vStorInj(cs,q,d,t,y) - vStorOut(cs,q,d,t,y);
2195   
2196  * ------------------------------
2197  * Storage capacity evolution
2198  * Tracks storage energy capacity builds/retirements.
2199  * ------------------------------
2200   
2201  * TODO: Why is it defined for all generators (g) rather than just storage (st)?
2202  * Limits total installed storage capacity to predefined technical data from pStorageData and CSP-related capacity from pCSPData. Only applies if storage is included (fEnableStorage).
2203  eCapacityStorLimit(g,y)$fEnableStorage..
2204     vCapStor(g,y) =l= pStorageData(g,"CapacityMWh") + pCSPData(g,"Storage","CapacityMWh");
2205   
2206  * Sets initial year’s storage capacity equal to existing capacity (if online) plus new builds minus retirements.
2207  eCapStorBalance(g, sStartYear(y))..
2208      vCapStor(g,y) =e= pStorageData(g,"CapacityMWh")$(eg(g) and (pGenData(g,"StYr") <= sStartYear.val)) + vBuildStor(g,y) - vRetireStor(g,y);
2209   
2210  * Tracks annual storage capacity changes for existing generators (EGs): previous year’s capacity + builds − retirements.
2211  eCapStorAnnualUpdateEG(eg,y)$(not sStartYear(y) and fEnableStorage)..
2212     vCapStor(eg,y) =e= vCapStor(eg,y-1) + vBuildStor(eg,y) - vRetireStor(eg,y);
2213   
2214  * Tracks annual storage capacity for new generators (NGs): previous year’s capacity + builds. Assumes no retirement.
2215  eCapStorAnnualUpdateNG(ng,y)$(not sStartYear(y) and fEnableStorage)..
2216     vCapStor(ng,y) =e= vCapStor(ng,y-1) + vBuildStor(ng,y);
2217   
2218  * Sets initial capacity for new generators at start year equal to build amount. Applies only in the first year.
2219  eCapStorInitialNG(ng,sStartYear(y))$fEnableStorage..
2220     vCapStor(ng,y) =e= vBuildStor(ng,y);
2221   
2222  eBuildStorNew(eg)$((pGenData(eg,"StYr") > sStartYear.val) and fEnableStorage)..
2223     sum(y, vBuildStor(eg,y)) =l= pStorageData(eg,"CapacityMWh");
2224   
2225  * ------------------------------
2226  * CSP thermal capacity limits
2227  * Tracks CSP thermal field builds and limits.
2228  * ------------------------------
2229  eCapacityThermLimit(g,y)$fEnableCSP..
2230     vCapTherm(g,y) =l= pCSPData(g,"Thermal Field","CapacityMWh");
2231   
2232  eCapThermBalance1(eg,y)$(not sStartYear(y) and fEnableCSP)..
2233     vCapTherm(eg,y) =e= vCapTherm(eg,y-1) + vBuildTherm(eg,y) - vRetireTherm(eg,y);
2234   
2235  eCapThermBalance2(ng,y)$(not sStartYear(y) and fEnableCSP)..
2236     vCapTherm(ng,y) =e= vCapTherm(ng,y-1) + vBuildTherm(ng,y);
2237   
2238  eCapThermBalance3(ng,sStartYear(y))$fEnableCSP..
2239     vCapTherm(ng,y) =e= vBuildTherm(ng,y);
2240   
2241  eBuildThermNew(eg)$((pGenData(eg,"StYr") > sStartYear.val) and fEnableCSP)..
2242     sum(y, vBuildTherm(eg,y)) =l= pCSPData(eg,"Thermal Field","CapacityMWh");
2243   
2244  * ------------------------------
2245  * Capital budget constraint
2246  * Enforces the global investment ceiling.
2247  * ------------------------------
2248   
2249  eCapitalConstraint$fApplyCapitalConstraint..
2250     sum(y, pRR(y)*pWeightYear(y)*sum(ng, pCRF(ng)*vCap(ng,y)*pGenData(ng,"Capex"))) =l= ssMaxCapitalInvestmentInvestment*1e3;
2251   
2252  * ------------------------------
2253  * Emissions related equations
2254  * Computes CO₂ emissions and applies caps/backstops.
2255  * ------------------------------
2256   
2257  eZonalEmissions(z,y)..
2258     vZonalEmissions(z,y) =e=
2259     sum((gzmap(g,z),gfmap(g,f),q,d,t), vPwrOut(g,f,q,d,t,y)*pHeatRate(g,f)*pFuelCarbonContent(f)*pHours(q,d,t));
2260   
2261  eEmissionsCountry(c,y)$fApplyCountryCo2Constraint..
2262     sum(zcmap(z,c), vZonalEmissions(z,y))-vYearlyCO2backstop(c,y)=l= pEmissionsCountry(c,y);
2263   
2264  eTotalEmissions(y)..
2265      sum(z, vZonalEmissions(z,y))=e= vTotalEmissions(y);
2266   
2267  eTotalEmissionsConstraint(y)$fApplySystemCo2Constraint..
2268      vTotalEmissions(y)-vYearlySysCO2backstop(y) =l= pEmissionsTotal(y);
2269   
