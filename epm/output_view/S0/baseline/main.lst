1383  Binary Variable
1384     isOn(g,q,d,t,AT,y)         '1 when generator g is online during the chronological slot represented by (q,d,t,AT)'
1385     isStartup(g,q,d,t,AT,y)    '1 when the generator transitions from offline to online during the mapped slot'
1386     isShutdown(g,q,d,t,AT,y)   '1 when the generator transitions from online to offline during the mapped slot'
