2412   
INCLUDE    /Data/Mexico_2026/epm/hydrogen_module.gms
2414   
2415   
2416  Sets
2417     H2status  'H2 generation plant status' / Existing, Candidate, Committed /
2418     eh(hh)           'existing hydrogen generation plants'
2419     nh(hh)           'new hydrogen generation plants'
2420     RampRateH2(hh)   'ramp rate constrained H2 generator blocks' // Ramprate takes out inflexible generators for a stronger formulation so that it runs faster
2421     dcH2(hh)         'candidate generators with capex trajectory'
2422     ndcH2(hh)        'candidate generators without capex trajectory'
2423     nRE(g)           'non RE generators'
2424     nVRE(g)          'non VRE generators'
2425     REH2(g)          'set of RE generators which are NOT VRE'
2426     nREH2(g)         'set of generators that are dont belong to subset REH2(g)'
2427     h2zmap(hh,z)
2428     sH2PwrIn(hh,q,d,t,y)
2429  ;
2430   
2431  Sets
2432     H2statusmap(hh,H2status) 'Hydrogen unit status'
2433  ;
2434   
2435  Parameters
2436      fEnableH2Production
2437     pCRFH2(hh)                       'Capital recovery factor'
2438     pCapexTrajectoriesH2(hh,y)       'CAPEX trajectories for hydrogen generation units'
2439     pVarCostH2(hh,y)                 'Variable cost - H2 production'
2440     pH2UnservedCost                  'Cost of external H2 unserved'
2441     pH2Data(hh,pH2Header)                    'Hydrogen production specifications'
2442  ;
2443   
2444  Positive Variables
2445     vCapH2(hh,y)                'total capacity in place accounting for legacy, new and retired plants (MW)'
2446     vBuildH2(hh,y)              'Build (MW)'
2447     vRetireH2(hh,y)             'Retire (MW)'
2448     vH2PwrIn(hh,q,d,t,y)        'Power drawn by H2 plants for H2 production in MW'
2449     vFuelH2(z,y)                'Annual H2 production in MMBTU'
2450     vAnnCapexH2(hh,y)           'Annualized CAPEX of H2 producing technologies'
2451     vPwrREH2(z,q,d,t,y)          'Generation from RE generators that goes to H2 production'
2452     vPwrREGrid(z,q,d,t,y)       'Generation from RE generators that goes to the grid'
2453     vREPwr2H2(g,f,q,d,t,y)       'Generation from RE generators that goes to H2 production'
2454     vREPwr2Grid(g,f,q,d,t,y)    'Generation from VRE generators that goes to the grid'
2455     vFuelH2Quarter(z,q,y)        'H2 fuel saved for H2 electricity generationon a quarterly basis'
2456     vUnmetExternalH2(z,q,y)        'mmBTU of external H2 demand that cant be met'
2457     vYearlyH2UnservedCost(z,y)   'Annual Cost of external H2 unserved in USD'
2458  ;
2459   
2460  Integer variable
2461     vBuiltCapVarH2(hh,y)
2462     vRetireCapVarH2(hh,y)
2463  ;
2464   
2465  Equations
2466      eH2UnservedCost(z,y)
2467      eCapBalanceH2(hh,y)
2468      eCapBalance1H2(hh,y)
2469      eCapBalance2H2
2470      eBuildNewH2(hh)
2471      eBuiltCapH2(hh,y)
2472      eRetireCapH2(hh,y)
2473      eMaxCF_H2(hh,q,y)
2474      eFuel_H2(c,q,y)
2475      eFuel_H2_2(c,z,y)
2476      eRampDnLimitH2(hh,q,d,t,y)
2477      eRampUpLimitH2(hh,q,d,t,y)
2478      eFuelLimitH2(c,f,y)
2479      eFuelLimitH2_2(c,f,y)
2480      eAnnCapexH2_1(hh,y)
2481      eAnnCapexH2(hh,y)
2482      eRE2H2(g,f,q,d,t,y)
2483      eRE2H2_2(z,q,d,t,y)
2484      eRE2H2_3(z,q,d,t,y)
2485      eRE2H2_4(z,q,d,t,y)
2486      eMaxH2PwrInjection(hh,q,d,t,y)
2487  ;
2488   
2489   
2490  * =============================
2491  * Hydrogen Contributions to Main Equations
2492  * =============================
2493   
2494  * --- Hydrogen Contribution to Yearly Cost ---
2495  Equation eYearlyTotalCost_H2Contribution;
2496   
2497  eYearlyTotalCost_H2Contribution(c,y)..
2498  *   vYearlyTotalCost(c,y) =e= vYearlyTotalCost(c,y)
2499      0 =e=
2500                            + sum(zcmap(z,c), vYearlyH2UnservedCost(z,y))$fEnableH2Production;
2501   
2502  * --- Hydrogen Contribution to Total Annualized CAPEX ---
2503  Equation eTotalAnnualizedCapex_H2Contribution;
2504   
2505  eTotalAnnualizedCapex_H2Contribution(z,y)..
2506  *   vAnnCapex(z,y) =e= vAnnCapex(z,y)
2507      0 =e=
2508                     + sum(h2zmap(ndcH2,z), pCRFH2(ndcH2)*vCapH2(ndcH2,y)*pH2Data(ndcH2,"Capex")*1e6)$fEnableH2Production
2509                     + sum(h2zmap(dcH2,z), vAnnCapexH2(dcH2,y))$fEnableH2Production;
2510   
2511  * --- Hydrogen Contribution to Yearly Variable O&M Cost ---
2512  Equation eYearlyVOMCost_H2Contribution;
2513   
2514  eYearlyVOMCost_H2Contribution(z,y)..
2515  *   vYearlyVOMCost(z,y) =e= vYearlyVOMCost(z,y)
2516      0 =e=
2517                           + sum((h2zmap(hh,z),q,d,t), pVarCostH2(hh,y)*pH2Data(hh,"Heatrate")*vH2PwrIn(hh,q,d,t,y)*pHours(q,d,t))$fEnableH2Production;
2518   
2519  * --- Hydrogen Unserved Demand Cost (can stay modular as-is) ---
2520  Equation eH2UnservedCost;
2521   
2522  eH2UnservedCost(z,y)..
2523     vYearlyH2UnservedCost(z,y) =e= sum(q, vUnmetExternalH2(z,q,y)) * pH2UnservedCost $fEnableH2Production;
2524   
2525  * --- Hydrogen Supply Contribution to Demand Balance ---
2526  Equation eSupply_H2Contribution;
2527   
2528  * TODO: Change that
2529  eSupply_H2Contribution(z,q,d,t,y)..
2530  *   vSupply(z,q,d,t,y) =e=vSupply(z,q,d,t,y)
2531  *        -sum((gzmap(g,z),gfmap(g,f)),vPwrOut(g,f,q,d,t,y))
2532      0 =e=
2533       + sum((gzmap(nRE,z),gfmap(nRE,f)),vPwrOut(nRE,f,q,d,t,y))$(fEnableH2Production)
2534       + vPwrREGrid(z,q,d,t,y)$fEnableH2Production;
2535   
2536  * =============================
2537  * Hydrogen Specific Equations
2538  * =============================
2539   
2540   
2541  * Total capacity of H2 plants at 1st year of optimization is equal to pre-existing capacity plus capacity being bulit minus retired capacity
2542  eCapBalanceH2(hh,sStartYear(y))$(fEnableH2Production)..
2543     vCapH2(hh,y) =e= pH2Data(hh,"Capacity")$(eh(hh) and (pH2Data(hh,"StYr") <= sStartYear.val))
2544                 + vBuildH2(hh,y) - vRetireH2(hh,y);
2545   
2546  * Total capacity of existing H2 palnts is equal to capacity over previous year plus capacity being built in current year minus retired capacity in current year
2547  *Checked
2548  eCapBalance1H2(eh,y)$(not sStartYear(y) and fEnableH2Production)..
2549     vCapH2(eh,y) =e= vCapH2(eh,y-1) + vBuildH2(eh,y) - vRetireH2(eh,y);
2550   
2551  * Total capacity of candidate H2 plants is equal to total capacity at previous year plus capacity being built in current year minus retired capacity in current year
2552  *Checked
2553  eCapBalance2H2(nh,y)$(not sStartYear(y) and fEnableH2Production)..
2554     vCapH2(nh,y) =e= vCapH2(nh,y-1) + vBuildH2(nh,y);
2555   
2556  * New H2 plants can be buuilt only after the StYr; the newly built capacity need to be less than declared capacity
2557  *Checked
2558  eBuildNewH2(eh)$(pH2Data(eh,"StYr") > sStartYear.val and fEnableH2Production)..
2559      sum(y, vBuildH2(eh,y)) =l= pH2Data(eh,"Capacity");
2560   
2561   
2562  * (Integer units ) Built capacity each year is equal to unit size
2563  *Checked
2564  eBuiltCapH2(nh,y)$(pH2Data(nh,"DescreteCap") and fEnableH2Production)..
2565     vBuildH2(nh,y) =e= pH2Data(nh,"UnitSize")*vBuiltCapVarH2(nh,y);
2566   
2567  * (Integer units ) Retired capacity each year is equal to unit size
2568  *Checked
2569  eRetireCapH2(eh,y)$(pH2Data(eh,"DescreteCap") and (y.val <= pH2Data(eh,"RetrYr")) and fEnableH2Production)..
2570     vRetireH2(eh,y) =e= pH2Data(eh,"UnitSize")*vRetireCapVarH2(eh,y);
2571   
2572  *  Maximum capacity factor of H2 production based on availability
2573  *Checked
2574  eMaxCF_H2(hh,q,y)$(fEnableH2Production)..
2575     sum((d,t), vH2PwrIn(hh,q,d,t,y)*pHours(q,d,t)) =l= pAvailabilityH2(hh,q)*vCapH2(hh,y)*sum((d,t), pHours(q,d,t));
2576   
2577  *       mmBTU of H2 produced
2578  eFuel_H2(c,q,y)$(fEnableH2Production)..
2579  *                   mmBTU            mmBTU                    mmBTU                                                                     -MWe-                Hr                mmBTU/MWhe
2580      sum(zcmap(z,c), pExternalH2(z,q,y)-vUnmetExternalH2(z,q,y)$pExternalH2(z,q,y)+vFuelH2Quarter(z,q,y)) =e= sum( (zcmap(z,c),h2zmap(hh,z), d,t), vH2PwrIn(hh,q,d,t,y)*pHours(q,d,t)*pH2Data(hh,"HeatRate"));
2581   
2582  eFuel_H2_2(c,z,y)$(fEnableH2Production)..
2583      sum((zcmap(z,c),q),vFuelH2Quarter(z,q,y)) =e=  sum(zcmap(z,c),vFuelH2(z,y));
2584   
2585  eMaxH2PwrInjection(hh,q,d,t,y)$fEnableH2Production..
2586      vH2PwrIn(hh,q,d,t,y)  =l= vCapH2(hh,y);
2587   
2588  * The amount of hydrogen fuel that can be used for electricity generation can not be more than the amount of H2 that was produced from VRE curtailment
2589  eFuelLimitH2(c,f,y)$(pFuelDataH2(f) and fEnableH2Production)..
2590     sum((zcmap(z,c)),  vFuel(z,f,y)) =e=  sum((zcmap(z,c)), vFuelH2(z,y));
2591   
2592   
2593  *When the H2 production flag is off don't account for H2 fuel
2594  eFuelLimitH2_2(c,f,y)$(pFuelDataH2(f) and fEnableH2Production=0)..
2595     sum((zcmap(z,c)),  vFuel(z,f,y)) =e=  0;
2596   
2597   
2598  eRampDnLimitH2(hh,q,d,t,y)$(RamprateH2(hh) and not sFirstHour(t) and fApplyRampConstraint and fEnableH2Production)..
2599      vH2PwrIn(hh,q,d,t-1,y) -  vH2PwrIn(hh,q,d,t,y) =l= vCapH2(hh,y)*pH2Data(hh,"RampDnRate");
2600   
2601  eRampUpLimitH2(hh,q,d,t,y)$(RamprateH2(hh) and not sFirstHour(t) and fApplyRampConstraint and fEnableH2Production)..
2602     vH2PwrIn(hh,q,d,t,y) -  vH2PwrIn(hh,q,d,t-1,y) =l= vCapH2(hh,y)*pH2Data(hh,"RampUpRate");
2603   
2604  *Calculation of Annualized CAPEX for electrolyzers
2605  eAnnCapexH2_1(dcH2,y)$(not sStartYear(y) and fEnableH2Production)..
2606     vAnnCapexH2(dcH2,y) =e= vAnnCapexH2(dcH2,y-1)
2607                       + vBuildH2(dcH2,y)*pH2Data(dcH2,"Capex")*pCapexTrajectoriesH2(dcH2,y)*pCRFH2(dcH2)*1e6;
2608   
2609  eAnnCapexH2(dcH2,sStartYear(y))$fEnableH2Production..
2610     vAnnCapexH2(dcH2,y) =e= vBuildH2(dcH2,y)*pH2Data(dcH2,"Capex")*pCapexTrajectoriesH2(dcH2,y)*pCRFH2(dcH2)*1e6;                                                                          ;
2611   
2612  eRE2H2_4(z,q,d,t,y)$fEnableH2Production..
2613    sum(h2zmap(hh,z),vH2PwrIn(hh,q,d,t,y))=e=vPwrREH2(z,q,d,t,y);
2614   
2615   
2616  eRE2H2_3(z,q,d,t,y)$fEnableH2Production..
2617   vPwrREH2(z,q,d,t,y) =e= sum((gfmap(RE,f),gzmap(RE,z)),vREPwr2H2(RE,f,q,d,t,y));
2618   
2619  eRE2H2_2(z,q,d,t,y)$fEnableH2Production..
2620  vPwrREGrid(z,q,d,t,y)=e=sum((gfmap(RE,f),gzmap(RE,z)),vREPwr2Grid(RE,f,q,d,t,y));
2621   
2622  eRE2H2(RE,f,q,d,t,y)$fEnableH2Production..
2623   vPwrOut(RE,f,q,d,t,y)=e=vREPwr2Grid(RE,f,q,d,t,y)+vREPwr2H2(RE,f,q,d,t,y);
2624   
2625  *For example equation below is deactivated when H2 is on and is replaced by eVREProfile2
2626   
2627  * =============================
2628  * Updating Hydrogen Model
2629  * =============================
2630   
2631   
2633  Model PA /
2634   
2635      eYearlyTotalCost_H2Contribution,
2636      eTotalAnnualizedCapex_H2Contribution,
2637      eYearlyVOMCost_H2Contribution,
2638      eH2UnservedCost,
2639      eSupply_H2Contribution
2640   
2641     vH2PwrIn(sH2PwrIn)
2642     eBuildNewH2
2643     eCapBalance1H2
2644     eCapBalance2H2
2645     eCapBalanceH2
2646     eBuiltCapH2
2647     eRetireCapH2
2648  *eDemSupplyH2
2649     eMaxCF_H2
2650     eFuel_H2
2651     eFuel_H2_2
2652     eRampDnLimitH2
2653     eRampUpLimitH2
2654     eFuelLimitH2
2655     eFuelLimitH2_2
2656  *eYearlyCurtailmentCost2
2657   
2658     eRE2H2
2659     eRE2H2_2
2660     eRE2H2_3
2661     eRE2H2_4
2662     eMaxH2PwrInjection
2663   
2664     eAnnCapexH2_1
2665     eAnnCapexH2
2666     /
2667  ;
2669   
2670  *-------------------------------------------------------------------------------------
2671  * Generate gfmap and others from pGenDataInput
2672  parameter gstatIndex(gstatus) / Existing 1, Candidate 3, Committed 2 /;
2673  parameter tstatIndex(tstatus) / Candidate 3, Committed 2 /;
2674   
2675  *H2 model parameter
2676  parameter H2statIndex(H2status) / Existing 1, Candidate 3, Committed 2 /;
2677   
2678   
2679  * Aggregate `gmap(g,z,tech,f)` over `tech` and `f` to get `gzmap(g,z)`,
2680  * which represents the mapping of generator `g` to zone `z`.
2681  gzmap(g,z) = sum((tech,f), gmap(g,z,tech,f));
2682   
2683  * Aggregate `gmap(g,z,tech,f)` over `tech` and `z` to get `gfmap(g,f)`,
2684  * which represents the mapping of generator `g` to fuel `f`.
2685  gfmap(g,f) = sum((tech,z), gmap(g,z,tech,f));
2686   
2687  * Compute `gprimf(g,f)`, which is similar to `gfmap(g,f)`,
2688  * aggregating over `tech` and `z` to represent the primary fuel mapping.
2689  gprimf(g,f) = sum((tech,z), gmap(g,z,tech,f));
2690   
2691  * Aggregate `gmap(g,z,tech,f)` over `z` and `f` to get `gtechmap(g,tech)`,
2692  * which represents the mapping of generator `g` to technology `tech`.
2693  gtechmap(g,tech) = sum((z,f), gmap(g,z,tech,f));
2694   
2695  * TODO: Update `gfmap(g,f)`, ensuring it includes additional mappings
2696  * based on `pGenDataInput(g,z,tech,f2,'fuel2')` when a condition is met.
2697  * gfmap(g,f) = gfmap(g,f) or sum((z,tech,f2), (pGenDataInput(g,z,tech,f2,'fuel2') = pTechFuel(tech,f,'FuelIndex')));
2698   
2699   
2700  * Map generator status from input data
2701  gstatusmap(g,gstatus) = sum((z,tech,f),pGenDataInput(g,z,tech,f,'status')=gstatIndex(gstatus));
2702   
2703   
2704  pHeatrate(gprimf(g,f)) = sum((z,tech), pGenDataInput(g,z,tech,f,"Heatrate"));
2705  pHeatrate(g,f2)$(gfmap(g,f2) and not gprimf(g,f2)) =
2706      sum((z,tech,f), pGenDataInput(g,z,tech,f,"Heatrate2")
2707  *  $(pGenDataInput(g,z,tech,f,"fuel2") = pTechFuel(tech,f2,'FuelIndex'))
2708      );
2709   
2710   
2711  pGenData(g,pGenDataInputHeader) = sum((z,tech,f),pGenDataInput(g,z,tech,f,pGenDataInputHeader));
2712   
2713  ***********************H2 model parameters***************************************************
2714   
2715  pH2Data(hh,pH2Header)=pH2DataExcel(hh,pH2Header);
2716  H2statusmap(hh,H2status) = pH2DataExcel(hh,'status')=H2statIndex(H2status);
2717  * TODO: Check is that works for H2
2718  * h2zmap(hh,z) = pH2DataExcel(hh,'Zone')=pZoneIndex(z);
2719  h2zmap(hh,z) = pH2DataExcel(hh,'Zone');
2720   
2721  *-------------------------------------------------------------------------------------
2722   
2723  *--- Parameter initialisation for same demand profile for all years
2724   
INCLUDE    /Data/Mexico_2026/epm/generate_demand.gms
2726  **********************************************************************
2727  * ELECTRICITY PLANNING MODEL (EPM)
2728  * Developed at the World Bank
2729  **********************************************************************
2730  * Description:
2731  * This GAMS-based model is designed for electricity system planning,
2732  * incorporating capacity expansion, generation dispatch, and policy
2733  * constraints such as renewable energy targets, emissions reductions,
2734  * and market mechanisms.
2735  *
2736  * Author(s): ESMAP Modelling Team
2737  * Organization: World Bank
2738  * Version:
2739  * License: Creative Commons Zero v1.0 Universal
2740  *
2741  * Key Features:
2742  * - Optimization of electricity generation and capacity planning
2743  * - Inclusion of renewable energy integration and storage technologies
2744  * - Multi-period, multi-region modeling framework
2745  * - CO2 emissions constraints and policy instruments
2746  *
2747  * Notes:
2748  * - Ensure GAMS is installed before running this model.
2749  * - The model requires input data in .GDX or Excel format.
2750  *
2751  * Contact:
2752  * Claire Nicolas, cnicolas@worldbank.org
2753  **********************************************************************
2754   
2755  *--- Adjust peak and energy in case user selected same demand profile for all years
2756   
2757  Parameters
2758     pmax(z,y)
2759     pmin(z,y)
2760     pdiff(z,y)
2761     ptotalenergy(z,y)
2762     ptemp2(y)
2763     ptemp(y)
2764     pTempDemand(z,q,d,y,t)
2765  ;
2766   
2767  Variable
2768     pyval(z,q,d,y,t)
2769     divisor(z,y)
2770     obj
2771  ;
2772   
2773  divisor.lo(z,y) = card(q)*card(d)*card(t);
2774   
2775  Equation
2776     getDivisor(z,q,d,y,t)
2777     getArea(z,y)
2778     objFn
2779  ;
2780   
2781  getDivisor(z,q,d,y,t)..  pyval(z,q,d,y,t) =e=  [2*pdiff(z,y)/divisor(z,y) * (pmax(z,y) - pDemandProfile(z,q,d,t))]/sqr(pmax(z,y) - pmin(z,y));
2782  getArea(z,y)..           sum((q,d,t), pyval(z,q,d,y,t) * pHours(q,d,t)) =e=  pdiff(z,y);
2783  objFn..                  obj =e= sum((z,q,d,y,t), pyval(z,q,d,y,t));
2784   
2785  model demand / getDivisor, getArea, objFn /;
2786   
2787  * If using alt demand:
2788  if (pSettings("fUseSimplifiedDemand") = 1,
2789     pTempDemand(z,q,d,y,t) = pDemandProfile(z,q,d,t) * pDemandForecast(z,"Peak",y);
2790   
2791     pdiff(z,y) = ((pDemandForecast(z,"Energy",y)*1e3) - sum((q,d,t), pTempDemand(z,q,d,y,t)*pHours(q,d,t) )) ;
2792   
2793     pmax(z,y) = smax((q,d,t), pDemandProfile(z,q,d,t));
2794     pmin(z,y) = smin((q,d,t)$pDemandProfile(z,q,d,t), pDemandProfile(z,q,d,t));
2795  *   option limrow=1000; debugging
2796     Solve demand using nlp min obj;
2797   
2798     abort$(demand.modelstat<>1 and demand.modelstat<>2) 'Demand model not solved successfully';
2800     pDemandData(z,q,d,y,t) =  pTempDemand(z,q,d,y,t) + pyval.l(z,q,d,y,t);
2802     ptemp(y) = sum((z,q,d,t), pdemanddata(z,q,d,y,t)*pHours(q,d,t))/1000;
2803     ptemp2(y) = smax((q,d,t),sum(z, pdemanddata(z,q,d,y,t)));
2804  );
2805   
2806  ptotalenergy(z,y) =  sum((q,d,t), pdemanddata(z,q,d,y,t)*pHours(q,d,t))/1e3;
2807   
2808  *--- Part2: Start of initialisation of other parameters
2809   
2810  * Read main parameters from pSettings
2811   
2812  fEnableStorage                     = pSettings("fEnableStorage");
2813  fDispatchMode                      = pSettings("fDispatchMode");
2814   
2815  * --- Settings: Dispatch constraint switches
2816  fApplyMinGenCommitment      = pSettings("fApplyMinGenCommitment");
2817  fApplyStartupCost                  = pSettings("fApplyStartupCost");
2818  fApplyRampConstraint               = pSettings("fApplyRampConstraint");
2819  fApplyMUDT                       = pSettings("fApplyMUDT");
2820   
2821  * --- Settings: Economic parameters and penalties
2822  pDR                          = pSettings("DR");
2823  pWACC                        = pSettings("WACC");
2824  pVoLL                        = pSettings("VoLL");
2825  pPlanningReserveVoLL         = pSettings("ReserveVoLL");
2826  pSpinningReserveVoLL         = pSettings("SpinReserveVoLL");
2827  pSurplusPenalty              = pSettings("CostSurplus");
2828  pCostOfCurtailment           = pSettings("CostCurtail");
2829  pCostOfCO2backstop           = pSettings("CO2backstop");
2830  pH2UnservedCost              = pSettings("H2UnservedCost");
2831  ssMaxCapitalInvestmentInvestment = pSettings("sMaxCapitalInvestment") * 1e6;
2832   
2833  * --- Settings: Reserve requirements
2834  fApplyPlanningReserveConstraint    = pSettings("fApplyPlanningReserveConstraint");
2835  sReserveMarginPct                  = pSettings("sReserveMarginPct");
2836  fApplyCountrySpinReserveConstraint = pSettings("fApplyCountrySpinReserveConstraint");
2837  fApplySystemSpinReserveConstraint = pSettings("fApplySystemSpinReserveConstraint");
2838  psVREForecastErrorPct              = pSettings("sVREForecastErrorPct");
2839  sIntercoReserveContributionPct     = pSettings("sIntercoReserveContributionPct");
2840  fCountIntercoForReserves           = pSettings("fCountIntercoForReserves");
2841   
2842  * --- Settings: Policy and operational switches
2843  fApplyMinGenShareAllHours      = pSettings("fApplyMinGenShareAllHours");
2844  fApplyFuelConstraint               = pSettings("fApplyFuelConstraint");
2845  fApplyGenerationPhaseout           = pSettings("fApplyGenerationPhaseout");
2846  fApplyCapitalConstraint            = pSettings("fApplyCapitalConstraint");
2847  * Optional contracted transfer volumes. Absent from pSettings.csv means 0, so
2848  * this stays off unless a study asks for it.
2849  fApplyContractedTrade              = pSettings("fApplyContractedTrade");
2850  sContractedTradeFirstYear          = pSettings("sContractedTradeFirstYear");
2851  fEnableCSP                         = pSettings("fEnableCSP");
2852  fEnableCapacityExpansion           = pSettings("fEnableCapacityExpansion");
2853  pMinRE                             = pSettings("sMinRenewableSharePct");
2854  pMinsRenewableTargetYear           = pSettings("sRenewableTargetYear");
2855  fApplyCountryCo2Constraint         = pSettings("fApplyCountryCo2Constraint");
2856  fApplySystemCo2Constraint         = pSettings("fApplySystemCo2Constraint");
2857  fEnableCarbonPrice                     = pSettings("fEnableCarbonPrice");
2858  fEnableEnergyEfficiency           = pSettings("fEnableEnergyEfficiency");
2859   
2860   
2861  * --- Settings: Transmission and trade
2862  fEnableInternalExchange            = pSettings("fEnableInternalExchange");
2863  fRemoveInternalTransferLimit       = pSettings("fRemoveInternalTransferLimit");
2864  fAllowTransferExpansion            = pSettings("fAllowTransferExpansion");
2865  fAllowTransferExpansion            = fAllowTransferExpansion * fEnableCapacityExpansion;
2866   
2867  fEnableExternalExchange            = pSettings("fEnableExternalExchange");
2868  sMaxHourlyImportExternalShare                 = pSettings("sMaxHourlyImportExternalShare");
2869  sMaxHourlyExportExternalShare                 = pSettings("sMaxHourlyExportExternalShare");
2870   
2871  * --- Settings: Hydrogen options
2872  fEnableCapexTrajectoryH2           = pSettings("fEnableCapexTrajectoryH2");
2873  fEnableH2Production               = pSettings("fEnableH2Production");
2874   
2875  * ----------------------------
2876  singleton set sFinalYear(y);
2877  scalar TimeHorizon;
2878   
2879  sStartYear(y) = y.first;
2880  sFinalYear(y) = y.last;
2881  TimeHorizon = sFinalYear.val - sStartYear.val + 1;
2882  sFirstHour(t) = t.first;
2883  sLastHour(t) = t.last;
2884  sFirstDay(d) = d.first;
2885   
2886  sFirstHourAT(AT) = AT.first;
2887   
2888  sLastDay(d) = yes$(ord(d) = card(d));
2889   
2890  * ------------------------------
2891  * Commitment initialization defaults
2892  * Consolidates initial ON/OFF values so a single section shows which units start online.
2893  * ------------------------------
2894  pInitialOnStart(g) = 0;
2895  pInitialOnStart(g)$pGenData(g,"InitialOn") = pGenData(g,"InitialOn");
2896   
2897   
2898  pStorageInitShare = pSettings("InitialSOCforBattery");
2899  if (pStorageInitShare < 0,
2900     pStorageInitShare = 0.5;
2901  );
2902   
2903  FD(q,d,t) = yes;
2904  if (fDispatchMode,
2905     FD(q,d,t)$(ord(q) eq 2 and ord(d) > 28) = no;
2906     FD(q,d,t)$((ord(q) eq 4 or ord(q) eq 6 or ord(q) eq 9 or ord(q) eq 11) and ord(d) > 30) = no;
2907  );
2908   
2909  * Identify which generators carry minimum-generation commitments so that startup cost logic can focus on them.
2910  MinGenPoint(g) = yes$(pGenData(g,"MinGenCommitment") > 0);
2911   
2912  * ------------------------------
2913   
2914   
2915  * Set external transfer limits to zero if exports are not allowed
2916  pExtTransferLimit(z,zext,q,"Import",y)$(not fEnableExternalExchange)  = 0 ;
2917  pExtTransferLimit(z,zext,q,"Export",y)$(not fEnableExternalExchange)  = 0 ;
2918   
2919  * Assign import and export transfer limits only if exports are allowed
2920  pExtTransferLimitIn(z,zext,q,y)$fEnableExternalExchange   = pExtTransferLimit(z,zext,q,"Import",y) ;
2921  pExtTransferLimitOut(z,zext,q,y)$fEnableExternalExchange  = pExtTransferLimit(z,zext,q,"Export",y) ;
2922   
2923  * Define `Zt(z)` to check if total demand in a zone `z` is zero
2924  Zt(z) = sum((q,d,y,t),pDemandData(z,q,d,y,t)) = 0;
2925  * Define `Zd(z)` as the complement of `Zt(z)`, indicating zones with demand
2926  Zd(z) = not Zt(z);
2927   
2928   
2929  * Aggregate storage data from the 4-index pStorageDataInput to pStorageData(g,header)
2930  pStorageData(g,pStorageDataHeader) = sum((z,tech,f), pStorageDataInput(g,z,tech,f,pStorageDataHeader));
2931   
2932  * gsmap is used for linked storage (PV+storage pairs)
2933  * gsmap(g2,g) means storage g is linked to generator g2
2934  * For standalone storage (empty "Linked plant"), gsmap remains empty
2935  * Note: If linked storage is needed, the "Linked plant" column should contain the generator name
2936  gsmap(g2,g) = no;
2937   
2938  * Identify candidate generators (`ng(g)`) based on their status in `gstatusmap`
2939  ng(g)  = gstatusmap(g,'candidate') or gstatusmap(g,'committed');
2940   
2941  * Define existing generators (`eg(g)`) as those that are not candidates, include comitted
2942  eg(g)  = not ng(g);
2943   
2944  * Identify variable renewable energy (VRE) generators (`vre(g)`) based on hourly variation data
2945  vre(g) = sum((gtechmap(g,tech),f)$pTechFuel(tech,f,'HourlyVariation'),1);
2946   
2947  * Identify renewable energy (RE) generators (`re(g)`) based on RE technology classification
2948  re(g)  = sum((gtechmap(g,tech),f)$pTechFuel(tech,f,'RETechnology'),1);
2949   
2950  * Identify concentrated solar power (CSP) technologies
2951  cs(g)  = gtechmap(g,"CSPPlant");
2952   
2953  * Identify PV with storage technologies
2954  so(g)  = gtechmap(g,"PVwSTO");
2955   
2956  * Identify solar thermal with PV (`STOPV`)
2957  stp(g) = gtechmap(g,"STOPV");
2958   
2959  * Identify storage technologies
2960  stg(g) = gtechmap(g,"Storage");
2961   
2962  * Define a general storage category (`st(g)`) as either `STOPV` or `STORAGE`
2963  st(g)  = gtechmap(g,"STOPV") or gtechmap(g,"Storage");
2964   
2965  * Define generators with capex trajectory data
2966  dc(g)  = sum(y, pCapexTrajectories(g,y));
2967   
2968  * Define generators without capex trajectory data
2969  ndc(g) = not dc(g);
2970   
2971  * Identify run-of-river hydro generators (`ror(g)`)
2972  ror(g) = gtechmap(g,"ROR");
2973   
2974  * Identify VRE generators excluding run-of-river hydro (`VRE_noROR(g)`)
2975  VRE_noROR(g) = vre(g) and not ror(g);
2976   
2977  * Define ramp-down rate for generators
2978  RampRate(g) = pGenData(g,"RampDnRate");
2979   
2980  * Map zones (`z`) to fuels (`f`) based on generator-fuel assignments (`gzmap` and `gfmap`)
2981  zfmap(z,f) = sum((gzmap(g,z),gfmap(g,f)), 1);
2982   
2983  * H2 model specific sets
2984  nh(hh)  = H2statusmap(hh,'candidate');
2985  eh(hh)  = not nh(hh);
2986  RampRateH2(hh)= pH2Data(hh,"RampDnRate");
2987  dcH2(hh)  = sum(y, pCapexTrajectoryH2(hh,y));
2988  ndcH2(hh) = not dcH2(hh);
2989  nRE(g) = not re(g);
2990  nVRE(g)=not VRE(g);
2991  REH2(g)= sum((gtechmap(g,tech),f)$pTechFuel(tech,f,'RETechnology'),1) - sum((gtechmap(g,tech),f)$pTechFuel(tech,f,'HourlyVariation'),1);
2992  nREH2(g)= not REH2(g);
2993   
2994  *-------------------------------------------------------------------
2995  * TOPOLOGY DEFINITION
2996  *-------------------------------------------------------------------
2997   
2998  * Defining sTopology based on existing, committed and candidate transmission lines
2999  sTopology(z,z2) = sum((q,y),pTransferLimit(z,z2,q,y)) + sum(pTransmissionHeader,pNewTransmission(z,z2,pTransmissionHeader)) + sum(pTransmissionHeader,pNewTransmission(z2,z,pTransmissionHeader));
3000   
3001  * If not running in interconnected mode, set network to 0
3002  sTopology(z,z2)$(not fEnableInternalExchange) = no;
3003   
3004  * if ignore transfer limit, set limits to high value
3005  pTransferLimit(sTopology,q,y)$fRemoveInternalTransferLimit = inf;
3006   
3007  * Default life for transmission lines
3008  pNewTransmission(sTopology,"Life")$(pNewTransmission(sTopology,"Life")=0 and fAllowTransferExpansion) = 30;
3009   
3010  * Map transmission status from input data
3011  tstatusmap(sTopology(z,z2),tstatus) = (pNewTransmission(z,z2, 'status')=tstatIndex(tstatus)) + (pNewTransmission(z2,z, 'status')=tstatIndex(tstatus));
3012   
3013  * Identify candidate generators (`ng(g)`) based on their status in `gstatusmap`
3014  commtransmission(sTopology(z,z2))  = tstatusmap(z,z2,'committed');
3015   
3016  *-------------------------------------------------------------------
3017  * CAPACITY CREDIT
3018  *-------------------------------------------------------------------
3019   
3020  * Identify the system peak demand for each year based on the highest total demand across all zones, times, and demand segments
3021  pFindSysPeak(y)     = smax((t,d,q), sum(z, pDemandData(z,q,d,y,t)));
3022   
3023  * Identify hours that are close to the peak demand for capacity credit calculations
3024  pAllHours(q,d,y,t)  = 1$(abs(sum(z,pDemandData(z,q,d,y,t))/pFindSysPeak(y) - 1)<pSettings("sPeakLoadProximityThreshold"));
3025   
3026  * Default capacity credit for all generators is set to 1
3027  pCapacityCredit(g,y)= 1;
3028   
3029  * Protect against unintended changes while modifying `pVREgenProfile` with `pVREProfile` data
3030  pVREgenProfile(VRE,q,d,t)$(not(pVREgenProfile(VRE,q,d,t))) = sum((z,tech)$(gzmap(VRE,z) and gtechmap(VRE,tech)),pVREProfile(z,tech,q,d,t));
3031   
3032  * Set capacity credit for VRE based on predefined values or calculated generation-weighted availability
3033  pCapacityCredit(VRE,y) =  Sum((z,q,d,t)$gzmap(VRE,z),Sum(f$gfmap(VRE,f),pVREgenProfile(VRE,q,d,t)) * pAllHours(q,d,y,t)) * (Sum((z,f,q,d,t)$(gfmap(VRE,f) and gzmap(VRE,z) ),pVREgenProfile(VRE,q,d,t))/sum((q,d,t),1));
3034   
3035  * Compute capacity credit for run-of-river hydro as an availability-weighted average
3036  pCapacityCredit(ROR,y) =  sum(q,pAvailability(ROR,y,q)*sum((d,t),pHours(q,d,t)))/sum((q,d,t),pHours(q,d,t));
3037   
3038  * Compute CSP and PV with storage generation profiles
3039  pCSPProfile(cs,q,d,t)    = sum((z,tech)$(gtechmap(cs,tech) and gzmap(cs,z)), pVREProfile(z,tech,q,d,t));
3040  pStoPVProfile(so,q,d,t)  =  sum((z,tech)$(gtechmap(so,tech) and gzmap(so,z)), pVREProfile(z,tech,q,d,t));
3041   
3042  * H2 model parameters
3043  pCapexTrajectoriesH2(hh,y) =1;
3044  pCapexTrajectoriesH2(dch2,y)$fEnableCapexTrajectoryH2 = pCapexTrajectoryH2(dcH2,y);
3045   
3046  *-------------------------------------------------------------------
3047  * Cost of capital
3048  *-------------------------------------------------------------------
3049   
3050  * Set the weight of the start year to 1.0
3051  pWeightYear(sStartYear) = 1.0;
3052  * Compute weight for each year as the difference from the previous year's cumulative weight
3053  pWeightYear(y)$(not sStartYear(y)) = y.val - sum(sameas(y2+1,y), y2.val) ;
3054   
3055  * Compute the present value discounting factor considering mid-period adjustments
3056  pRR(y) = 1.0;
3057  pRR(y)$(ord(y)>1) = 1/((1+pDR)**(sum(y2$(ord(y2)<ord(y)),pWeightYear(y2))-1 + sum(sameas(y2,y), pWeightYear(y2)/2))) ;
3058   
3059  *-------------------------------------------------------------------
3060  * Parameter Processing
3061  *-------------------------------------------------------------------
3062  pLossFactorInternal(z2,z,y)$(pLossFactorInternal(z,z2,y) and not pLossFactorInternal(z2,z,y)) = pLossFactorInternal(z,z2,y);
3063   
3064  pEnergyEfficiencyFactor(z,y)$(not fEnableEnergyEfficiency) = 1;
3065  pEnergyEfficiencyFactor(z,y)$(pEnergyEfficiencyFactor(z,y)=0) = 1;
3066   
3067  pVOMCost(gfmap(g,f),y) = pGenData(g,"VOM")
3068                         + pStorageData(g, "VOMMWh")
3069                         + pCSPData(g, "Storage", "VOMMWh")
3070                         + pCSPData(g, "Thermal Field", "VOMMWh");
3071   
3072  pFuelCost(g,f,y)$(gfmap(g,f)) = sum((gzmap(g,z),zcmap(z,c)),pFuelPrice(c,f,y)*pHeatRate(g,f));
3073  pVarCost(g,f,y)$(gfmap(g,f)) = pFuelCost(g,f,y) + pVOMCost(g,f,y);
3074  pVarCostH2(hh,y) = pH2Data(hh,"VOM");
3075   
3076  * pCRF refers to the Capital Recovery Factor, which is used to calculate the annualized cost of capital for a project.
3077  pCRF(g)$pGenData(g,'Life') = pWACC / (1 - (1 / ( (1 + pWACC)**pGenData(g,'Life'))));
3078  pCRFH2(hh)$pH2Data(hh,'Life') = pWACC / (1 - (1 / ( (1 + pWACC)**pH2Data(hh,'Life'))));
3079  pCRFsst(st)$pGenData(st,'Life') = pWACC / (1 - (1 / ( (1 + pWACC)**pGenData(st,'Life'))));
3080  pCRFcst(cs)$pGenData(cs,'Life') = pWACC / (1 - (1 / ( (1 + pWACC)**pGenData(cs,'Life'))));
3081  pCRFcth(cs)$pGenData(cs,'Life') = pWACC / (1 - (1 / ( (1 + pWACC)**pGenData(cs,'Life'))));
3082   
3083  * Defines which connected zones belong to different countries.
3084  sMapConnectedZonesDiffCountries(sTopology(z,z2)) = sum(c$(zcmap(z,c) and zcmap(z2,c)), 1) = 0;
3085   
3086  *** Simple bounds
3087   
3088  * Set upper limit for generation capacity based on predefined data
3089  vCap.up(g,y) = pGenData(g,"Capacity");
3090   
3091  * Fix the build decision variable to zero for existing generation projects (started before or at the model start year)
3092  vBuild.fx(eg,y)$(pGenData(eg,"StYr") <= sStartYear.val) = 0;
3093   
3094  * Set the upper limit for new generation builds per year, accounting for the annual build limit and year weighting
3095  * Exclude committed generators - they use Capacity directly, not BuildLimitperYear
3096  vBuild.up(ng,y)$(not gstatusmap(ng,'committed')) = pGenData(ng,"BuildLimitperYear")*pWeightYear(y);
3097   
3098  * Force committed generators (status=2) to be built at their start year.
3099  * Unlike candidates, committed generators are not optional - they must be built.
3100  * They remain in ng(g) so their CAPEX is included in total cost (unlike existing generators).
3101  * Note: BuildLimitperYear is ignored for committed generators - full capacity is built at StYr.
3102  * When StYr is not a model year, the build happens in the first model year on or after StYr
3103  * (previous model year < StYr <= y). pPrevModelYear is 0 for the first model year.
3104  Parameter pPrevModelYear(y) 'Previous model year (0 for the first year)';
3105  pPrevModelYear(y) = sum(y2$(ord(y2) = ord(y) - 1), y2.val);
3106  vBuild.lo(ng,y)$(gstatusmap(ng,'committed') and (pGenData(ng,"StYr") <= y.val) and (pGenData(ng,"StYr") > pPrevModelYear(y))) = pGenData(ng,"Capacity");
3107  vBuild.up(ng,y)$(gstatusmap(ng,'committed') and (pGenData(ng,"StYr") <= y.val) and (pGenData(ng,"StYr") > pPrevModelYear(y))) = pGenData(ng,"Capacity");
3108   
3109  * Define the upper limit for additional transmission capacity, subject to high transfer allowance
3110  vNewTransmissionLine.up(sTopology(z,z2),y)$fAllowTransferExpansion = max(pNewTransmission(z,z2,"MaximumNumOfLines"),pNewTransmission(z2,z,"MaximumNumOfLines"));
3111   
3112  sAdditionalTransfer(sTopology(z,z2),y) = yes;
3113  sAdditionalTransfer(sTopology(z,z2),y) $((y.val < pNewTransmission(z,z2,"EarliestEntry")) or (y.val < pNewTransmission(z2,z,"EarliestEntry"))) = no;
3114   
3115  * Fix
3116  vNewTransmissionLine.fx(commtransmission(z,z2),y)$((max(pNewTransmission(z,z2,"EarliestEntry"),pNewTransmission(z2,z,"EarliestEntry")) <= y.val) and fAllowTransferExpansion) = max(pNewTransmission(z,z2,"MaximumNumOfLines"),pNewTransmission(z2,z,"MaximumNumOfLines"));
3117  vNewTransmissionLine.fx(commtransmission(z,z2),y)$(not sAdditionalTransfer(z,z2,y) and fAllowTransferExpansion) = 0;
3118   
3119  * Compute bounds
3120  vBuildTransmissionLine.lo(sTopology(z,z2),y) = max(0,vNewTransmissionLine.lo(z,z2,y) - vNewTransmissionLine.up(z,z2,y-1));
3121  vBuildTransmissionLine.up(sTopology(z,z2),y) = max(0,vNewTransmissionLine.up(z,z2,y) - vNewTransmissionLine.lo(z,z2,y-1));
3122   
3123  * Fix the storage build variable to zero if the project started before the model start year and storage is included
3124  vBuildStor.fx(eg,y)$(pGenData(eg,"StYr") <= sStartYear.val and fEnableStorage) = 0;
3125   
3126  * Fix the thermal build variable to zero if the project started before the model start year and CSP (Concentrated Solar Power) is included
3127  vBuildTherm.fx(eg,y)$(pGenData(eg,"StYr") <= sStartYear.val and fEnableCSP) = 0;
3128   
3129  * Disable all capacity expansion decisions when flag is off
3130  if (fEnableCapacityExpansion = 0,
3131     vBuild.fx(g,y)            = 0;
3132     vBuiltCapVar.fx(g,y)      = 0;
3133     vBuildStor.fx(g,y)        = 0;
3134     vBuildTherm.fx(g,y)       = 0;
3135     vBuildTransmissionLine.fx(z,z2,y) = 0;
3136     vNewTransmissionLine.fx(z,z2,y)   = 0;
3137     vBuildH2.fx(hh,y)         = 0;
3138     vBuiltCapVarH2.fx(hh,y)   = 0;
3139  );
3140   
3141  *-------------------------------------------------------------------
3142  * Fixed conditions
3143  *-------------------------------------------------------------------
3144   
3145   
3146  ********************* Load a previously saved solution**********************************************************
3147   
3148  * Load a previously saved solution from the specified path (if LOADSOLPATH is defined)
3149  * This solution contains the .l (level) values of capacity-related variables from a previous run
3151   
3152  ********************* Equations for generation capacity**********************************************************
3153  * Fix capacity to zero for generation projects that have not yet started in a given year
3154  vCap.fx(g,y)$(pGenData(g,"StYr") > y.val) = 0;
3155   
3156  * Set the fixed capacity for existing generation projects at the start year, if they were commissioned before the model start year
3157  vCap.fx(eg,sStartYear)$(pGenData(eg,"StYr") < sStartYear.val) = pGenData(eg,"Capacity");
3158   
3159  * Set fixed capacity for generation projects in years where they are within their operational period
3160  vCap.fx(eg,y)$((pGenData(eg,"StYr") <= y.val) and (pGenData(eg,"StYr") >= sStartYear.val)) = pGenData(eg,"Capacity");
3161   
3162  * Retire capacity by setting it to zero in the year of retirement
3163  vCap.fx(eg,y)$(pGenData(eg,"RetrYr") and (pGenData(eg,"RetrYr") <= y.val)) = 0;
3164   
3165  * Set the initial thermal capacity for CSP plants at the model start year, if commissioned before that year
3166  vCapTherm.fx(eg,sStartYear)$(pGenData(eg,"StYr") < sStartYear.val) = pCSPData(eg,"Thermal Field","CapacityMWh");
3167   
3168  * Set the initial storage capacity at the model start year, considering both CSP and standalone storage units
3169  vCapStor.fx(eg,sStartYear)$(pGenData(eg,"StYr") < sStartYear.val) = pCSPData(eg,"Storage","CapacityMWh") + pStorageData(eg,"CapacityMWh");
3170   
3171  * Prevent decommissioning of storage hours from existing storage when economic retirement is disabled
3172  vCapStor.fx(eg,y)$((pSettings("fEnableEconomicRetirement") = 0) and (pGenData(eg,"StYr") <= y.val) and (pGenData(eg,"RetrYr") >= y.val)) = pStorageData(eg,"CapacityMWh");
3173   
3174  * Fix the retirement variable to zero, meaning no unit is retired by default unless specified otherwise
3175  vRetire.fx(ng,y) = 0;
3176   
3177  * Ensure plants with a lifetime of 99 years (considered effectively infinite) are not retired
3178  vRetire.fx(eg,y)$(pGenData(eg,"Life") = 99) = 0;
3179   
3180  * Ensure capacity remains unchanged when economic retirement is disabled and the plant is still within its operational lifetime
3181  vCap.fx(eg,y)$((pSettings("fEnableEconomicRetirement") = 0 and pGenData(eg,"StYr") < y.val) and (pGenData(eg,"RetrYr") >= y.val)) = pGenData(eg,"Capacity");
3182   
3183  * Prevent thermal capacity from appearing in years before the commissioning date
3184  vCapTherm.fx(ng,y)$(pGenData(ng,"StYr") > y.val) = 0;
3185   
3186  * Prevent storage capacity from appearing in years before the commissioning date
3187  vCapStor.fx(ng,y)$(pGenData(ng,"StYr") > y.val) = 0;
3188   
3189  * Ensure storage capacity is set to zero if storage is not included in the scenario
3190  vCapStor.fx(ng,y)$(not fEnableStorage) = 0;
3191   
3192   
3193  ********************* Equations for hydrogen production**********************************************************
3194  *Maximum capacity is equal to "Capacity"
3195  vCapH2.up(hh,y) = pH2Data(hh,"Capacity");
3196   
3197  *No new capacity can be built for existing generators
3198  vBuildH2.fx(eh,y)$(pH2Data(eh,"StYr") <= sStartYear.val) = 0;
3199   
3200  *The new capacity for new generators can not exceed the annual limit
3201  vBuildH2.up(nh,y) = pH2Data(nh,"BuildLimitperYear")*pWeightYear(y);
3202   
3203  *Electrolyzers can not operate at days with zero demand (applicable to dispatch model)
3204  vH2PwrIn.fx(hh,q,d,t,y)$(sum(z,pDemandData(z,q,d,y,t))  =0)   =0;
3205   
3206  *The maximum power drawn for H2 production can't be more than the Capacity of the electrolyzer
3207  vH2PwrIn.up(hh,q,d,t,y)  =pH2Data(hh,"Capacity");
3208   
3209   
3210  vCapH2.fx(hh,y)$(pH2Data(hh,"StYr") > y.val)=0;
3211  vCapH2.fx(eh,sStartYear)$(pH2Data(eh,"StYr") < sStartYear.val) = pH2Data(eh,"Capacity");
3212  vCapH2.fx(eh,y)$((pH2Data(eh,"StYr") <= y.val) and (pH2Data(eh,"StYr") >= sStartYear.val)) = pH2Data(eh,"Capacity");
3213  vCapH2.fx(eh,y)$(pH2Data(eh,"RetrYr") and (pH2Data(eh,"RetrYr") <= y.val)) = 0;
3214   
3215  vRetireH2.fx(nh,y) = 0;
3216  vRetireH2.fx(eh,y)$(pH2Data(eh,"Life") = 99) = 0;
3217   
3218  vCapH2.fx(eh,y)$((pSettings("fEnableEconomicRetirement") = 0 and pH2Data(eh,"StYr") < y.val) and (pH2Data(eh,"RetrYr") >= y.val)) = pH2Data(eh,"Capacity");
3219   
3220  sH2PwrIn(hh,q,d,t,y) = yes;
3221   
3222  if (fEnableH2Production,
3223    vREPwr2H2.fx(nRE,f,q,d,t,y) = 0;
3224    vREPwr2Grid.fx(nRE,f,q,d,t,y) = 0;
3225  );
3226   
3227  *******************************************************************************************************************
3228   
3229  sPwrOut(gfmap(g,f),q,d,t,y) = yes;
3230  sPwrOut(gfmap(st,f),q,d,t,y)$(not fEnableStorage) = yes;
3231   
3232  * If price based export is not allowed, set to 0
3233  sExportPrice(z,zext,q,d,t,y)$(fEnableExternalExchange) = yes;
3234  sExportPrice(z,zext,q,d,t,y)$(not fEnableExternalExchange) = no;
3235   
3236  * If price based import is not allowed, set to 0
3237  sImportPrice(z,zext,q,d,t,y)$(fEnableExternalExchange) = yes;
3238  sImportPrice(z,zext,q,d,t,y)$(not fEnableExternalExchange) = no;
3239   
3240  vYearlyImportExternal.up(z,zext,q,d,t,y)$fEnableExternalExchange = pExtTransferLimitIn(z,zext,q,y);
3241  vYearlyExportExternal.up(z,zext,q,d,t,y)$fEnableExternalExchange = pExtTransferLimitOut(z,zext,q,y);
3242   
3243  * Do not allow imports and exports for a zone without import/export prices
3244  sExportPrice(z,zext,q,d,t,y)$(pTradePrice(zext,q,d,y,t)= 0) = no;
3245  sImportPrice(z,zext,q,d,t,y)$(pTradePrice(zext,q,d,y,t)= 0) = no;
3246   
3247  * Define the flow of electricity between zones
3248  sFlow(z,z2,q,d,t,y)$(sTopology(z,z2)) = yes;
3249   
3250  * Define spinning reserve constraints based on the settings for zonal and system spinning reserves
3251  sSpinningReserve(g,q,d,t,y)$((fApplyCountrySpinReserveConstraint or fApplySystemSpinReserveConstraint) ) = yes;
3252   
3253  *To avoid bugs when there is no candidate transmission expansion line
3254  pNewTransmission(z,z2,"EarliestEntry")$(not fAllowTransferExpansion) = 2500;
3255   
3256  *-------------------------------------------------------------------------------------
3257  * Ensure that variables fixed (`.fx`) at specific values remain unchanged during the solve process
3258  PA.HoldFixed=1;
3259   
3260  * Declare a file object `fmipopt` and set its name dynamically based on the modeltype
3261  file fmipopt / cplex.opt /;
3262  * Check if the set `mipopt` contains any elements (i.e., if modeltype options exist)
3263  if (card(mipopt),
3264   put fmipopt;
3265  * Loop over each entry in `mipopt` and write its text content to the file
3266   loop(mipline, put mipopt.te(mipline) /);
3267   putclose;
3268  );
3269   
3270  * Enable the modeltype to read an external modeltype option file
3271  PA.optfile = 1;
3272   
3273   
3274  * ############## SOLVE ##############
3275  * SOLVEMODE == 2 solves as usual
3276  * SOLVEMODE == 1 solves as usual but generates a savepoint file at the end
3277  * SOLVEMODE == 0 uses a savepoint file to skip the solve (This speeds up development of post solve features)
3278   
3281   
3282   
3284  *  Solve model as usual
3285     Solve PA using RMIP minimizing vNPVcost;
3286  *  Abort if model was not solved successfully
3287     abort$(not (PA.modelstat=1 or PA.modelstat=8)) 'ABORT: no feasible solution found.', PA.modelstat;
3289   
3290  *  Export model data only when debugging is enabled
3292  * ####################################
3293   
3294  * Include the external report file specified by `%REPORT_FILE%`
3295   
3298   
INCLUDE    /Data/Mexico_2026/epm/generate_report.gms
3300  **********************************************************************
3301  * ELECTRICITY PLANNING MODEL (EPM)
3302  * Developed at the World Bank
3303  **********************************************************************
3304  * Description:
3305  * This GAMS-based model is designed for electricity system planning,
3306  * incorporating capacity expansion, generation dispatch, and policy
3307  * constraints such as renewable energy targets, emissions reductions,
3308  * and market mechanisms.
3309  *
3310  * Author(s): ESMAP Modelling Team
3311  * Organization: World Bank
3312  * Version:
3313  * License: Creative Commons Zero v1.0 Universal
3314  *
3315  * Key Features:
3316  * - Optimization of electricity generation and capacity planning
3317  * - Inclusion of renewable energy integration and storage technologies
3318  * - Multi-period, multi-region modeling framework
3319  * - CO2 emissions constraints and policy instruments
3320  *
3321  * Notes:
3322  * - Ensure GAMS is installed before running this model.
3323  * - The model requires input data in .GDX or Excel format.
3324  *
3325  * Contact:
3326  * Claire Nicolas, cnicolas@worldbank.org
3327  **********************************************************************
3328   
3329   
3331  * Report
3332   
3333  set sumhdr /
3334    "Investment costs: $m",
3335    "Fixed O&M: $m",
3336    "Variable O&M: $m",
3337    "Startup costs: $m",
3338    "Fuel costs: $m",
3339    "Transmission costs: $m",
3340    "Spinning reserve costs: $m",
3341    "Unmet demand costs: $m",
3342    "Unmet country spinning reserve costs: $m",
3343    "Unmet country planning reserve costs: $m",
3344    "Unmet country CO2 backstop cost: $m",
3345    "Unmet system planning reserve costs: $m",
3346    "Unmet system spinning reserve costs: $m",
3347    "Unmet system CO2 backstop cost: $m",
3348    "Excess generation: $m",
3349    "VRE curtailment: $m",
3350    "Import costs with external zones: $m",
3351    "Export revenues with external zones: $m",
3352    "Import costs with internal zones: $m",
3353    "Export revenues with internal zones: $m",
3354    "Trade shared benefits: $m",
3355    "Carbon costs: $m",
3356    "NPV of system cost: $m"
3357  /;
3358   
3359  * Set of demand-related summary labels
3360  set dshdr /
3361    "Demand: GWh",
3362    "Electricity demand for H2 production: GWh",
3363    "Total Demand (Including P to H2): GWh",
3364    "Total production: GWh",
3365    "Unmet demand: GWh",
3366    "Surplus generation: GWh",
3367    "Imports exchange: GWh",
3368    "Exports exchange: GWh",
3369    "Net interchange: GWh",
3370    "Net interchange Ratio: GWh"
3371  /;
3372   
3373  * H2-specific
3374  set dsH2hdr /
3375    "Electricity demand for H2 production: GWh",
3376    "Total H2 Production: mmBTU",
3377    "External Demand of H2: mmBTU",
3378    "Unmet External Demand of H2: mmBTU",
3379    "H2 produced for power production: mmBTU"
3380  /;
3381   
3382  set zgmap(z,g); option zgmap<gzmap;
3383  set zH2map(z,hh); option zH2map<h2zmap;
3384  set isExternal / Internal, External /;
3385   
3386  set capexComponent /
3387    Generation,
3388    StorageEnergy,
3389    CSPThermalField,
3390    CSPStorage,
3391    Hydrogen,
3392    Transmission
3393  /;
3394   
3395  set capexComponentPlant(capexComponent) /
3396    Generation,
3397    StorageEnergy,
3398    CSPThermalField,
3399    CSPStorage
3400  /;
3401   
3402  set genCostCmp /
3403    "Investment costs: $m",
3404    "Fixed O&M: $m",
3405    "Variable Cost: $m"
3406  /;
3407   
3408  set fEnergyBalance /
3409    "UnmetDemand",
3410    "Surplus",
3411    "Imports",
3412    "Imports External",
3413    "Exports",
3414    "Exports External"
3415  /;
3416   
