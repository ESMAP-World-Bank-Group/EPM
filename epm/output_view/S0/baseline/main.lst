3595  * 10. METRICS
3596  * ============================================================
3597   
3598    pPlantAnnualLCOE(z,g,y)          'Plant-level LCOE [USD/MWh] by year'
3599    pGenCostsPerMWh(z,genCostCmp,y)   'Zone generation cost by component [USD/MWh]'
3600    pNetPresentCostPerMWh(z,sumhdr)  'Zone cost per discounted demand [USD/MWh]'
3601    pNetPresentCostCountryPerMWh(c,sumhdr) 'Country cost per discounted demand [USD/MWh]'
3602    pCostsPerMWh(z,sumhdr,y)         'Zone average cost by component [USD/MWh]'
3603    pCostsCountryPerMWh(c,sumhdr,y)  'Country average cost by component [USD/MWh]'
3604    pCostsSystemPerMWh(sumhdr, y)    'System average cost [USD/MWh] by year'
3605   
3606  * ============================================================
3607  * 11. modeltype PARAMETERS
3608  * ============================================================
3609     pSolverParameters(*)                      'modeltype parameters'
3610  ;
3611   
3612  * Mapping
3613   
3614  pGeneratorTechFuel(g, tech, f) = sum(z, gmap(g, z, tech, f));
3615  pGeneratorTechFuel(g, tech, f)$pGeneratorTechFuel(g, tech, f) = 1;
3616   
3617  pZoneCountry(z, c) = zcmap(z, c);
3618  pZoneCountry(z, c)$pZoneCountry(z, c) = 1;
3619   
3620   
3621  * ============================================================
3622  * 1. CAPACITY
3623  * ============================================================
3624   
3625  * ---------------------------------------------------------
3626  * Plant and technology-level capacity and utilization
3627  * ---------------------------------------------------------
3628  * Records installed capacity, retirements, and utilization
3629  * factors for each plant and aggregated by technology:
3630  *   - pCapacityPlant: installed capacity by plant
3631  *   - pRetirementsPlant: retired capacity by plant
3632   
3633  * ---------------------------------------------------------
3634   
3635  pCapacityPlant(zgmap(z,g),y)                 = vCap.l(g,y);
3636   
3637  pNewCapacityPlant(zgmap(z,g),y)              = vBuild.l(g,y);
3638   
3639  pRetirementsPlant(zgmap(z,g),y)                  = vRetire.l(g,y);
3640   
3641   
3642  * ---------------------------------------------------------
3643  * Capacity, new builds, retirements, and utilization by fuel and technology
3644  * ---------------------------------------------------------
3645  * Tracks installed capacity, new capacity, and retirements
3646  * disaggregated by fuel type and technology.
3647  * Also computes utilization factors:
3648  *   - pCapacityTechFuel / pCapacityFuel: installed capacity
3649  *   - pNewCapacityFuel / pNewCapacityTech: new builds
3650  *   - pRetirementsFuel: retirements
3651   
3652  * ---------------------------------------------------------
3653   
3654  * Installed capacity by technology and fuel [MW]
3655  pCapacityTechFuel(z, tech, f, y) =
3656    sum((gzmap(g, z), gtechmap(g, tech), gprimf(g, f)), vCap.l(g, y));
3657   
3658  * Installed capacity by fuel [MW]
3659  pCapacityFuel(z, f, y) =
3660    sum((gzmap(g, z), gprimf(g, f)), vCap.l(g, y));
3661   
3662  * New capacity by fuel [MW]
3663  pNewCapacityFuel(z, f, y) =
3664    sum((gzmap(g, z), gprimf(g, f)), vBuild.l(g, y));
3665   
3666  * New capacity by technology [MW]
3667  pNewCapacityTech(z, tech, y) =
3668    sum((gzmap(g, z), gtechmap(g, tech), gprimf(g, f)), vBuild.l(g, y));
3669   
3670  * New capacity by technology and fuel [MW]
3671  pNewCapacityTechFuel(z, tech, f, y) =
3672    sum((gzmap(g, z), gtechmap(g, tech), gprimf(g, f)), vBuild.l(g, y));
3673   
3674  * Retirements by fuel [MW]
3675  pRetirementsFuel(z, f, y) =
3676    sum((gzmap(g, z), gprimf(g, f)), vRetire.l(g, y));
3677   
3678  * ---------------------------------------------------------
3679  * Transmission capacity expansion and annual limits
3680  * ---------------------------------------------------------
3681  * pNewTransmissionCapacity:
3682  *   - Incremental transmission capacity built in year y
3683  *   - Based on yearly build decisions and per-line capacity
3684  *
3685  * pTransmissionCapacity:
3686  *   - Total available transfer capacity in a year
3687  *   - Equals existing maximum transfer limit plus any new additions
3688  * ---------------------------------------------------------
3689   
3690  pNewTransmissionCapacity(sTopology(z,z2),y) =
3691    vBuildTransmissionLine.l(z,z2,y)
3692    * max(pNewTransmission(z,z2,"CapacityPerLine"),pNewTransmission(z2,z,"CapacityPerLine"))
3693    * fAllowTransferExpansion;
3694   
3695  pAdditionalTransmissionCapacity(sTopology(z,z2),y) = vNewTransmissionLine.l(z,z2,y)*max(pNewTransmission(z,z2,"CapacityPerLine"),pNewTransmission(z2,z,"CapacityPerLine"))*fAllowTransferExpansion;
3696  pTransmissionCapacity(sTopology(z,z2),y) = pAdditionalTransmissionCapacity(z,z2,y) + smax(q, pTransferLimit(z,z2,q,y)) ;
3697   
3698  * ---------------------------------------------------------
3699  * Country-level capacity, new builds, retirements, and utilization
3700  * ---------------------------------------------------------
3701  * Aggregates zonal results to the country level:
3702  *   - pCapacityPlantCountry: installed capacity by plant
3703  *   - pCapacityTechFuelCountry / pCapacityFuelCountry: installed capacity by tech-fuel or fuel
3704  *   - pNewCapacityFuelCountry / pNewCapacityTechCountry: new builds by fuel or tech
3705  *   - pRetirementsFuelCountry / pRetirementsCountry: retirements by fuel and total
3706  *   - pUtilizationFuelCountry / pUtilizationTechFuelCountry:
3707  *       utilization factors (energy ÷ capacity × hours) by fuel or tech-fuel
3708  * ---------------------------------------------------------
3709   
3710  pCapacityTechFuelCountry(c, tech, f, y) =
3711    sum(zcmap(z, c), pCapacityTechFuel(z, tech, f, y));
3712   
3713  pCapacityFuelCountry(c, f, y) =
3714    sum(zcmap(z, c), pCapacityFuel(z, f, y));
3715   
3716  pNewCapacityFuelCountry(c, f, y) =
3717    sum(zcmap(z, c), pNewCapacityFuel(z, f, y));
3718   
3719  pNewCapacityTechCountry(c, tech, y) =
3720    sum(zcmap(z, c), pNewCapacityTech(z, tech, y));
3721   
3722  pNewCapacityTechFuelCountry(c, tech, f, y) =
3723    sum(zcmap(z, c), pNewCapacityTechFuel(z, tech, f, y));
3724   
3725  pRetirementsFuelCountry(c, f, y) =
3726    sum(zcmap(z, c), pRetirementsFuel(z, f, y));
3727   
3728  pRetirementsCountry(c, y) =
3729    sum((zcmap(z, c), f), pRetirementsFuel(z, f, y));
3730   
3731  * ---------------------------------------------------------
3732  * Capacity summary at zone and country level [MW]
3733  * ---------------------------------------------------------
3734  * Provides aggregated indicators of system capacity:
3735  *   - Available capacity
3736  *   - Peak demand (with and without power-to-hydrogen load)
3737  *   - New capacity builds
3738  *   - Retired capacity
3739  *   - Committed total transmission capacity
3740  * Reported at both zonal and country aggregation levels.
3741  * ---------------------------------------------------------
3742   
3743  pCapacitySummary(z,"Available capacity: MW",y) = sum(gzmap(g,z), vCap.l(g,y));
3744  pCapacitySummary(z,"Peak demand: MW"       ,y) = smax((q,d,t), pDemandData(z,q,d,y,t)*pEnergyEfficiencyFactor(z,y));
3745  pCapacitySummary(z,"Peak demand including P to H2: MW"       ,y) = smax((h2zmap(hh,z),q,d,t), pDemandData(z,q,d,y,t)*pEnergyEfficiencyFactor(z,y) + vH2PwrIn.l(hh,q,d,t,y))$fEnableH2Production+1e-6;
3746  pCapacitySummary(z,"New capacity: MW"      ,y) = sum(gzmap(g,z), vBuild.l(g,y));
3747  pCapacitySummary(z,"Retired capacity: MW"  ,y) = sum(gzmap(g,z), vRetire.l(g,y));
3748  pCapacitySummary(z,"Committed Total TX capacity: MW"  ,y) = sum((z2,q), pTransferLimit(z,z2,q,y)/card(q));
3749   
3750  pCapacitySummaryCountry(c,"Available capacity: MW",y) = sum(zcmap(z,c), pCapacitySummary(z,"Available capacity: MW",y));
3751  pCapacitySummaryCountry(c,"Peak demand: MW"       ,y) = smax((q,d,t), sum(zcmap(z,c), pDemandData(z,q,d,y,t)*pEnergyEfficiencyFactor(z,y)));
3752  pCapacitySummaryCountry(c,"New capacity: MW"      ,y) = sum(zcmap(z,c), pCapacitySummary(z,"New capacity: MW",y));
3753  pCapacitySummaryCountry(c,"Retired capacity: MW"  ,y) = sum(zcmap(z,c), pCapacitySummary(z,"Retired capacity: MW",y));
3754  pCapacitySummaryCountry(c,"Committed Total TX capacity: MW",y) = sum(zcmap(z,c), pCapacitySummary(z,"Committed Total TX capacity: MW",y));
3755   
3756  * H2 model additions
3757  pCapacityPlantH2(zh2map(z,hh),y) = vCapH2.l(hh,y)$fEnableH2Production+1e-6;
3758   
3759  * ============================================================
3760  * 2. COSTS
3761  * ============================================================
3762   
3763  * Reporting costs by plant
3764  * Plant-level cost reporting (prettier formatting)
3765  pCostsPlant(z, g, "Investment costs: $m", y)$gzmap(g, z) =
3766    vAnnGenCapex.l(g, y) / 1e6;
3767   
3768  pCostsPlant(z, g, "Fixed O&M: $m", y)$gzmap(g, z) =
3769    (
3770      vCap.l(g, y)      * pGenData(g, "FOMperMW")
3771      + vCapStor.l(g, y)  * pStorageData(g, "FixedOMMWh")
3772      + vCapStor.l(g, y)  * pCSPData(g, "Storage", "FixedOMMWh")
3773      + vCapTherm.l(g, y) * pCSPData(g, "Thermal field", "FixedOMMWh")
3774    ) / 1e6;
3775   
3776  pCostsPlant(z, g, "Variable Cost: $m", y)$gzmap(g, z) =
3777    sum((gfmap(g, f), q, d, t),
3778      pVarCost(g, f, y) * vPwrOut.l(g, f, q, d, t, y) * pHours(q, d, t)
3779    ) / 1e6;
3780   
3781  pCostsPlant(z, g, "Spinning Reserve Cost: $m", y)$gzmap(g, z) =
3782    sum((q, d, t),
3783      vSpinningReserve.l(g, q, d, t, y) * pGenData(g, "ReserveCost") * pHours(q, d, t)
3784    ) / 1e6;
3785   
3786  * ---------------------------------------------------------
3787  * Plant-level CAPEX investment breakdown [USD]
3788  * ---------------------------------------------------------
3789  * Stores the non-Investment costs flows for each plant and
3790  * component so that we can add dedicated transmission and
3791  * hydrogen entries later on.
3792  * ---------------------------------------------------------
3793   
3794  * Generation CAPEX - with capex trajectories (dc)
3795  pCapexInvestmentPlant(zgmap(z,g), "Generation", y)$((not st(g)) and dc(g)) =
3796    1e6 * vBuild.l(g, y) * pGenData(g, "Capex") * pCapexTrajectories(g, y);
3797   
3798  * Generation CAPEX - without capex trajectories (ndc) - use trajectory = 1
3799  pCapexInvestmentPlant(zgmap(z,g), "Generation", y)$((not st(g)) and ndc(g)) =
3800    1e6 * vBuild.l(g, y) * pGenData(g, "Capex");
3801   
3802  * Storage CAPEX - with capex trajectories (dc)
3803  pCapexInvestmentPlant(zgmap(z,g), "StorageEnergy", y)$((st(g)) and (not cs(g)) and dc(g)) =
3804    1e3 * vBuildStor.l(g, y) * pStorageData(g, "CapexMWh") * pCapexTrajectories(g, y) +
3805    1e6 * vBuild.l(g, y) * pGenData(g, "Capex") * pCapexTrajectories(g, y);
3806   
3807  * Storage CAPEX - without capex trajectories (ndc) - use trajectory = 1
3808  pCapexInvestmentPlant(zgmap(z,g), "StorageEnergy", y)$((st(g)) and (not cs(g)) and ndc(g)) =
3809    1e3 * vBuildStor.l(g, y) * pStorageData(g, "CapexMWh") +
3810    1e6 * vBuild.l(g, y) * pGenData(g, "Capex");
3811   
3812  * CSP Thermal Field CAPEX - with capex trajectories (dc)
3813  pCapexInvestmentPlant(zgmap(z,g), "CSPThermalField", y)$(cs(g) and dc(g)) =
3814    1e3 * vBuildTherm.l(g, y) * pCSPData(g, "Thermal Field", "CapexMWh") * 1e3 * pCapexTrajectories(g, y);
3815   
3816  * CSP Thermal Field CAPEX - without capex trajectories (ndc) - use trajectory = 1
3817  pCapexInvestmentPlant(zgmap(z,g), "CSPThermalField", y)$(cs(g) and ndc(g)) =
3818    1e3 * vBuildTherm.l(g, y) * pCSPData(g, "Thermal Field", "CapexMWh") * 1e3;
3819   
3820  * CSP Storage CAPEX - with capex trajectories (dc)
3821  pCapexInvestmentPlant(zgmap(z,g), "CSPStorage", y)$(cs(g) and dc(g)) =
3822    1e3 * vBuildStor.l(g, y) * pCSPData(g, "Storage", "CapexMWh") * pCapexTrajectories(g, y);
3823   
3824  * CSP Storage CAPEX - without capex trajectories (ndc) - use trajectory = 1
3825  pCapexInvestmentPlant(zgmap(z,g), "CSPStorage", y)$(cs(g) and ndc(g)) =
3826    1e3 * vBuildStor.l(g, y) * pCSPData(g, "Storage", "CapexMWh");
3827   
3828  * Derive zonal totals per component (generation-related ones come from plants)
3829  pCapexInvestmentComponent(z, capexComponentPlant, y) =
3830    sum(zgmap(z, g), pCapexInvestmentPlant(z, g, capexComponentPlant, y));
3831   
3832  * Hydrogen CAPEX is tracked separately
3833  pCapexInvestmentComponent(z, "Hydrogen", y)$fEnableH2Production =
3834    1e6 * sum(zH2map(z, hh),
3835      vBuildH2.l(hh, y) * pH2Data(hh, "Capex") * pCapexTrajectoriesH2(hh, y)
3836    );
3837   
3838  * Transmission CAPEX additions
3839  pCapexInvestmentComponent(z, "Transmission", y)$(fAllowTransferExpansion and sum(sTopology(z, z2), 1)) =
3840    0.5 * sum(sTopology(z, z2),
3841      vBuildTransmissionLine.l(z, z2, y)
3842      * max(pNewTransmission(z,z2,"CostPerLine"),pNewTransmission(z2,z,"CostPerLine"))
3843      * 1e6
3844    );
3845   
3846  pCapexInvestmentTransmission(sTopology(z, z2), y)$fAllowTransferExpansion =
3847    0.5 * vBuildTransmissionLine.l(z, z2, y)
3848    * max(pNewTransmission(z,z2,"CostPerLine"),pNewTransmission(z2,z,"CostPerLine"))
3849    * 1e6;
3850   
3851  * ---------------------------------------------------------
3852  * Zone-level CAPEX investment flows [$]
3853  * ---------------------------------------------------------
3854  * Captures the annual capital expenditures for new builds
3855  * in zone z and year y, before annualization.
3856  *
3857  * Components:
3858  *   - Generation builds (MW × $/MW × cost trajectory)
3859  *   - Storage builds (MWh × $/MWh × cost trajectory)
3860  *   - CSP thermal field and storage builds (MWh × $/MWh × trajectory)
3861  *   - Hydrogen builds (MW × $/MW × cost trajectory), optional
3862  *   - Small epsilon added to avoid divide-by-zero issues
3863  * ---------------------------------------------------------
3864   
3865  pCapexInvestment(z, y) =
3866    sum(capexComponent, pCapexInvestmentComponent(z, capexComponent, y))
3867    + 1e-6;
3868   
3869   
3870  * ---------------------------------------------------------
3871  * Price calculation [$/MWh]
3872  * ---------------------------------------------------------
3873  * Market clearing price derived from the dual variable of the
3874  * demand-supply balance constraint, scaled by operating hours,
3875  * discount rate (pRR), and year weight.
3876  * --------------------------------------------------------
3877   
3878  pHourlyPrice(z,q,d,t,y)$(pHours(q,d,t)) = -eDemSupply.m(z,q,d,t,y)/pHours(q,d,t)/pRR(y)/pWeightYear(y);
3879   
3880  * ---------------------------------------------------------
3881  * Import and export costs with internal zones [$]
3882  * ---------------------------------------------------------
3883  * Import costs:
3884  *   - Value of inflows from neighboring zones
3885  *   - Calculated as local price × imported flow × hours
3886  *
3887  * Export revenues:
3888  *   - Value of outflows to neighboring zones
3889  *   - Negative sign ensures revenues reduce total cost
3890  * ---------------------------------------------------------
3891   
3892  pImportCostsInternal(z,y) = sum((sTopology(Zd,z),q,d,t), pHourlyPrice(z,q,d,t,y)*vFlow.l(Zd,z,q,d,t,y)*pHours(q,d,t));
3893   
3894  pExportRevenuesInternal(z,y) = - sum((sTopology(z,Zd),q,d,t), pHourlyPrice(z,q,d,t,y)*vFlow.l(z,Zd,q,d,t,y)*pHours(q,d,t));
3895   
3896  * ---------------------------------------------------------
3897  * Congestion rents between zones [$]
3898  * ---------------------------------------------------------
3899  * Difference in marginal prices × traded flow × hours
3900  * Negative sign ensures consistency with rent allocation
3901  * ---------------------------------------------------------
3902   
3903  pCongestionRevenues(z,Zd,y) = - sum((q,d,t), (pHourlyPrice(zD,q,d,t,y) - pHourlyPrice(z,q,d,t,y))*vFlow.l(z,Zd,q,d,t,y)*pHours(q,d,t));
3904   
3905  * ---------------------------------------------------------
3906  * Trade shared benefits [$]
3907  * ---------------------------------------------------------
3908  * Congestion rents are split equally (50/50) between
3909  * importing and exporting zones as the allocation rule
3910  * ---------------------------------------------------------
3911   
3912  pTradeSharedBenefits(z,y) = 0.5*sum(sTopology(Zd,z), pCongestionRevenues(Zd,z,y)) + 0.5*sum(sTopology(z,Zd), pCongestionRevenues(z,Zd,y));
3913   
3914  * ---------------------------------------------------------
3915  * Net trade costs with internal zones [$]
3916  * ---------------------------------------------------------
3917  * Equivalent formulation where:
3918  *   Trade cost = Import cost + Export revenues + Shared rents
3919  * This matches pricing trades at the average marginal price
3920  * between connected zones
3921  * ---------------------------------------------------------
3922   
3923  * pTradeCostsInternal(z,y) = pExportRevenuesInternal(z,y) + pImportCostsInternal(z,y) + pTradeSharedBenefits(z,y);
3924   
3925  * ---------------------------------------------------------
3926  * Demand allocation [GWh → TWh]
3927  * ---------------------------------------------------------
3928  * Zone-level demand:
3929  *   - Sum of hourly demand × operating hours
3930  *   - Adjusted by efficiency factor
3931  *   - Converted from GWh to TWh
3932  *
3933  * Country-level demand:
3934  *   - Aggregation of zonal demand by mapping zones to countries
3935  * ---------------------------------------------------------
3936  Parameter
3937    pDemandEnergyZone(z,y)         'Total energy demand [GWh] by zone and year'
3938    pDemandEnergyCountry(c,y)      'Total energy demand [GWh] by country and year'
3939    pDemandEnergySystem(y)         'Total system energy demand [GWh] by year'
3940    pDemandPeakZone(z,y)           'Peak demand [MW] by zone and year'
3941    pDemandPeakCountry(c,y)        'Peak demand [MW] by country and year'
3942    pDemandPeakSystem(y)           'Peak demand [MW] by year'
3943  ;
3944   
3945  pDemandEnergyZone(z,y) = sum((q,d,t), pDemandData(z,q,d,y,t) * pHours(q,d,t) * pEnergyEfficiencyFactor(z,y)) / 1e3;
3946  pDemandEnergyCountry(c,y) = sum(zcmap(z,c), pDemandEnergyZone(z,y));
3947  pDemandEnergySystem(y) = sum(z, pDemandEnergyZone(z,y));
3948   
3949  pDemandPeakZone(z,y) = smax((q,d,t), pDemandData(z,q,d,y,t) * pEnergyEfficiencyFactor(z,y));
3950  pDemandPeakCountry(c,y) = smax((q,d,t), sum(zcmap(z,c), pDemandData(z,q,d,y,t) * pEnergyEfficiencyFactor(z,y)));
3951  pDemandPeakSystem(y) = smax((q,d,t), sum(z, pDemandData(z,q,d,y,t) * pEnergyEfficiencyFactor(z,y)));
3952   
3953  * ---------------------------------------------------------
3954  * Zone-level cost components [$m]
3955  * ---------------------------------------------------------
3956  * Each entry in pCosts stores one annual cost component
3957  * at the zonal level in million $.
3958  *
3959  * Categories included:
3960  *   - Investment costs
3961  *   - Fixed O&M
3962  *   - Variable O&M
3963  *   - Fuel costs
3964  *   - Transmission costs
3965  *   - Spinning reserve costs
3966  *   - Unmet demand, reserve, and CO2 backstop costs
3967  *       (allocated proportionally to zonal demand at country/system level)
3968  *   - Excess generation
3969  *   - VRE curtailment
3970  *   - Import/export costs (external and internal zones)
3971  *   - Trade shared benefits
3972  *   - Carbon costs (system-wide total)
3973  * ---------------------------------------------------------
3974   
3975  * Investment-related costs
3976  pCosts(z, "Investment costs: $m", y) =
3977    vAnnCapex.l(z, y) / 1e6;
3978   
3979  pCosts(z, "Transmission costs: $m", y) =
3980    vAnnualizedTransmissionCapex.l(z, y) / 1e6;
3981   
3982  * Operation-related costs
3983  pCosts(z, "Fixed O&M: $m", y) =
3984    vYearlyFOMCost.l(z, y) / 1e6;
3985   
3986  pCosts(z, "Variable O&M: $m", y) =
3987    vYearlyVOMCost.l(z, y) / 1e6;
3988   
3989  pCosts(z, "Startup costs: $m", y) =
3990    vYearlyStartupCost.l(z, y) / 1e6;
3991   
3992  pCosts(z, "Fuel costs: $m", y) =
3993    vYearlyFuelCost.l(z, y) / 1e6;
3994   
3995  * System balancing costs
3996  pCosts(z, "Unmet demand costs: $m", y) =
3997    vYearlyUSECost.l(z, y) / 1e6;
3998   
3999  pCosts(z, "Excess generation: $m", y) =
4000    vYearlySurplus.l(z, y) / 1e6;
4001   
4002  pCosts(z, "VRE curtailment: $m", y) =
4003    vYearlyCurtailmentCost.l(z, y) / 1e6;
4004   
4005  * Reserve-related costs
4006  pCosts(z, "Spinning reserve costs: $m", y) =
4007    vYearlySpinningReserveCost.l(z, y) / 1e6;
4008   
4009  pCosts(z, "Unmet country spinning reserve costs: $m", y) =
4010    sum(c$(zcmap(z, c) and pDemandEnergyCountry(c, y) > 0),
4011      vYearlyUnmetSpinningReserveCostCountry.l(c, y) * (pDemandEnergyZone(z, y) / pDemandEnergyCountry(c, y))
4012    ) / 1e6;
4013   
4014  pCosts(z, "Unmet country planning reserve costs: $m", y) =
4015    sum(c$(zcmap(z, c) and pDemandEnergyCountry(c, y) > 0),
4016      vYearlyUnmetPlanningReserveCostCountry.l(c, y) * (pDemandEnergyZone(z, y) / pDemandEnergyCountry(c, y))
4017    ) / 1e6;
4018   
4019  pCosts(z, "Unmet system planning reserve costs: $m", y) =
4020    vYearlyUnmetPlanningReserveCostSystem.l(y) * (pDemandEnergyZone(z, y) / pDemandEnergySystem(y)) / 1e6;
4021   
4022  pCosts(z, "Unmet system spinning reserve costs: $m", y) =
4023    vYearlyUnmetSpinningReserveCostSystem.l(y) * (pDemandEnergyZone(z, y) / pDemandEnergySystem(y)) / 1e6;
4024   
4025  * Carbon-related costs
4026  pCosts(z, "Carbon costs: $m", y) =
4027    vYearlyCarbonCost.l(z, y) / 1e6;
4028   
4029  pCosts(z, "Unmet country CO2 backstop cost: $m", y) =
4030    sum(c$(zcmap(z, c) and pDemandEnergyCountry(c, y) > 0),
4031      vYearlyCO2BackstopCostCountry.l(c, y) * (pDemandEnergyZone(z, y) / pDemandEnergyCountry(c, y))
4032    ) / 1e6;
4033   
4034  pCosts(z, "Unmet system CO2 backstop cost: $m", y) =
4035    vYearlyCO2BackstopCostSystem.l(y) * (pDemandEnergyZone(z, y) / pDemandEnergySystem(y)) / 1e6;
4036   
4037  * Trade-related costs
4038  pCosts(z, "Import costs with internal zones: $m", y) =
4039    pImportCostsInternal(z, y) / 1e6;
4040   
4041  pCosts(z, "Export revenues with internal zones: $m", y) =
4042    pExportRevenuesInternal(z, y) / 1e6;
4043   
4044  pCosts(z, "Trade shared benefits: $m", y) =
4045    pTradeSharedBenefits(z, y) / 1e6;
4046   
4047  pCosts(z, "Import costs with external zones: $m", y) =
4048    vYearlyImportExternalCost.l(z, y) / 1e6;
4049   
4050  pCosts(z, "Export revenues with external zones: $m", y) =
4051    vYearlyExportExternalCost.l(z, y) / 1e6;
4052   
4053  * Discounted weighted yearly costs by zone
4054  pDiscountedWeightedCosts(z, sumhdr, y) =
4055      pCosts(z, sumhdr, y) * pRR(y) * pWeightYear(y);
4056   
4057  * Cost
4058  pNetPresentCost(z, sumhdr) =
4059      sum(y, pDiscountedWeightedCosts(z, sumhdr, y));
4060   
4061  * ---------------------------------------------------------
4062   
4063  * Cost by country and year
4064  pCostsCountry(c,sumhdr,y) = sum(z$(zcmap(z,c)), pCosts(z,sumhdr,y));
4065   
4066  * ---------------------------------------------------------
4067  * System-level cost summary
4068  * ---------------------------------------------------------
4069  * Aggregates all zone-level costs into a single system-wide
4070  * metric across the entire time horizon.
4071  *
4072  * - pNetPresentCostSystem(sumhdr):
4073  *     Weighted sum of all zone-level costs
4074  *     Units: million $ (after scaling)
4075  *
4076  * - "NPV of system cost: $m":
4077  *     The model's computed Net Present Value of system costs
4078  *     Directly taken from optimization variable vNPVCost
4079  * ---------------------------------------------------------
4080   
4081  pCostsSystem(sumhdr, y) = sum(z, pCosts(z, sumhdr, y));
4082   
4083  * pNetPresentCostSystem(sumhdr) = sum((y,z), pCosts(z,sumhdr,y) * pRR(y) * pWeightYear(y));
4084  pNetPresentCostSystem(sumhdr) = sum(z, pNetPresentCost(z,sumhdr));
4085   
4086  pNetPresentCostSystem("NPV of system cost: $m") = vNPVCost.l/1e6;
4087   
4088  * ---------------------------------------------------------
4089   
4090  * Annual average cost benchmarks ($/MWh) without discounting:
4091  * divide yearly costs by the matching energy basis.
4092  pCostsPerMWh(z,sumhdr,y) =
4093      pCosts(z,sumhdr,y)*1e6 / (pDemandEnergyZone(z,y) * 1e3);
4094   
4095  pCostsCountryPerMWh(c,sumhdr,y) =
4096      1e6 * pCostsCountry(c,sumhdr,y) / (pDemandEnergyCountry(c,y) * 1e3);
4097   
4098  pCostsSystemPerMWh(sumhdr,y) =
4099      1e6 * pCostsSystem(sumhdr, y) / (pDemandEnergySystem(y) * 1e3);
4100   
4101  * Discount zonal demand over the horizon; convert GWh -> MWh via 1e3
4102  * and apply both the discount rate (pRR) and scenario weight (pWeightYear).
4103  pDiscountedDemandZoneMWh(z) =
4104      sum(y, pDemandEnergyZone(z,y) * 1e3 * pRR(y) * pWeightYear(y));
4105   
4106  pDiscountedDemandCountryMWh(c) =
4107      sum(zcmap(z,c), pDiscountedDemandZoneMWh(z));
4108   
4109  pDiscountedDemandSystemMWh =
4110      sum(z, pDiscountedDemandZoneMWh(z));
4111   
4112  * Divide the discounted cost ledger by discounted demand to express
4113  * each zonal cost component as an average $/MWh metric.
4114  pNetPresentCostPerMWh(z,sumhdr)$pDiscountedDemandZoneMWh(z) =
4115      pNetPresentCost(z,sumhdr) * 1e6 / pDiscountedDemandZoneMWh(z);
4116   
4117  * Country totals reuse the zonal discounted costs and demands,
4118  * aggregating before taking the ratio so shared demand weights apply.
4119  pNetPresentCostCountryPerMWh(c,sumhdr)$pDiscountedDemandCountryMWh(c) =
4120      1e6 * sum(zcmap(z,c), pNetPresentCost(z,sumhdr)) / pDiscountedDemandCountryMWh(c);
4121   
4122  * System-wide average cost: sum of discounted zonal costs divided by
4123  * the discounted system demand (sum of zonal denominators).
4124  pNetPresentCostSystemPerMWh(sumhdr)$pDiscountedDemandSystemMWh =
4125      (pNetPresentCostSystem(sumhdr) * 1e6) / pDiscountedDemandSystemMWh;
4126   
4127  * ---------------------------------------------------------
4128  * Fuel costs and consumption [$m, PJ] by zone and country
4129  * ---------------------------------------------------------
4130  * Calculates annual fuel expenditures and consumption
4131  * based on generation output, heat rates, and fuel prices.
4132  * Results are stored at both zonal and country aggregation levels.
4133  * ---------------------------------------------------------
4134   
4135  pFuelCosts(z,f,y) = sum((gzmap(g,z),gfmap(g,f),zcmap(z,c),q,d,t), vPwrOut.l(g,f,q,d,t,y)*pHours(q,d,t)*pFuelPrice(c,f,y)*pHeatRate(g,f))/1e6;
4136  pFuelConsumption(z,f,y) = vFuel.l(z,f,y)/1e6;
4137   
4138  pFuelCostsCountry(c,f,y) = sum(zcmap(z,c), pFuelCosts(z,f,y));
4139  pFuelConsumptionCountry(c,f,y) = sum(zcmap(z,c), pFuelConsumption(z,f,y));
4140   
4141  * ============================================================
4142  * 3. ENERGY BALANCE
4143  * ============================================================
4144   
4145  * ---------------------------------------------------------
4146  * Energy generation by plant, technology-fuel, and country
4147  * ---------------------------------------------------------
4148  * Calculates annual electricity generation (TWh) from model
4149  * outputs at different aggregation levels:
4150  *   - pEnergyPlant: plant-level generation
4151  *   - pEnergyTechFuel / pEnergyTechFuelCountry: by technology and fuel, zonal and country
4152  *   - pEnergyTechFuelComplete: tech-fuel generation plus balance components
4153  *   - pEnergyFuel / pEnergyFuelCountry: by fuel, zonal and country
4154  * ---------------------------------------------------------
4155   
4156  pEnergyPlant(zgmap(z,g),y) = sum((gfmap(g,f),q,d,t), vPwrOut.l(g,f,q,d,t,y)*pHours(q,d,t))/1e3;
4157  pEnergyFuel(z,f,y) = sum((gzmap(g,z),gfmap(g,f),q,d,t), vPwrOut.l(g,f,q,d,t,y)*pHours(q,d,t))/1e3;
4158  pEnergyFuelCountry(c,f,y) = sum(zcmap(z,c), pEnergyFuel(z,f,y));
4159   
4160  * Energy balance including demand slack, surplus, and exchanges
4161  pEnergyFuelComplete(z,f,y) = pEnergyFuel(z,f,y);
4162  pEnergyFuelComplete(z,"UnmetDemand",y) = sum((q,d,t), vUSE.l(z,q,d,t,y)*pHours(q,d,t))/1e3;
4163  pEnergyFuelComplete(z,"Surplus",y) = sum((q,d,t), vSurplus.l(z,q,d,t,y)*pHours(q,d,t))/1e3;
4164  pEnergyFuelComplete(z,"Imports",y) = sum((sTopology(Zd,z),q,d,t), vFlow.l(Zd,z,q,d,t,y)*pHours(q,d,t))/1e3;
4165  pEnergyFuelComplete(z,"Imports External",y) = sum((zext,q,d,t), vYearlyImportExternal.l(z,zext,q,d,t,y)*pHours(q,d,t))/1e3;
4166  pEnergyFuelComplete(z,"Exports",y) = -sum((sTopology(z,Zd),q,d,t), vFlow.l(z,Zd,q,d,t,y)*pHours(q,d,t))/1e3;
4167  pEnergyFuelComplete(z,"Exports External",y) = -sum((zext,q,d,t), vYearlyExportExternal.l(z,zext,q,d,t,y)*pHours(q,d,t))/1e3;
4168   
4169  pEnergyTechFuel(z,tech,f,y) = sum((gzmap(g,z),gtechmap(g,tech),gfmap(g,f),q,d,t), vPwrOut.l(g,f,q,d,t,y)*pHours(q,d,t))/1e3;
4170  pEnergyTechFuelCountry(c,tech,f,y) = sum(zcmap(z,c), pEnergyTechFuel(z,tech,f,y));
4171  * Copy slack components under synthetic technology "EnergyBalance"
4172  pEnergyTechFuelComplete(z,tech,f,y) = pEnergyTechFuel(z,tech,f,y);
4173  pEnergyTechFuelComplete(z,"EnergyBalance",fEnergyBalance,y) = pEnergyFuelComplete(z,fEnergyBalance,y);
4174   
4175   
4176  * ---------------------------------------------------------
4177  * Utilization factors by plant, technology, fuel, and country
4178  * ---------------------------------------------------------
4179  * Computes average utilization (capacity factor) as the ratio
4180  * of generated energy to available capacity and hours:
4181  *   - pUtilizationPlant / pUtilizationTech: plant-level
4182  *     and tech-level capacity factors
4183  *   - pUtilizationFuel / pUtilizationTechFuel: by fuel and tech-fuel at zone level
4184  *   - pUtilizationFuelCountry / pUtilizationTechFuelCountry:
4185  *     by fuel and tech-fuel at country level
4186  * ---------------------------------------------------------
4187   
4188   
4189  * Plant-level utilization (capacity factor, annual average)
4190  pUtilizationPlant(zgmap(z,g),y)$vCap.l(g,y) =
4191    sum((gfmap(g,f), q, d, t), vPwrOut.l(g,f,q,d,t,y) * pHours(q,d,t))
4192    / vCap.l(g,y) / 8760;
4193   
4194  * Technology-level utilization (capacity factor, annual average)
4195  pUtilizationTech(z, tech, y)$sum((zgmap(z,g), gfmap(g,f), gtechmap(g,tech))$vCap.l(g,y), vCap.l(g,y)) =
4196    sum((zgmap(z,g), gfmap(g,f), gtechmap(g,tech), q, d, t)$vCap.l(g,y),
4197      vPwrOut.l(g,f,q,d,t,y) * pHours(q,d,t))
4198    / sum((zgmap(z,g), gfmap(g,f), gtechmap(g,tech))$vCap.l(g,y), vCap.l(g,y))
4199    / 8760;
4200   
4201  * Fuel-level utilization (capacity factor, annual average)
4202  pUtilizationFuel(z, f, y)$(pCapacityFuel(z, f, y)) =
4203    pEnergyFuel(z, f, y)
4204    / (pCapacityFuel(z, f, y) * sum((q, d, t), pHours(q, d, t)))
4205    * 1000;
4206   
4207  * Technology-fuel-level utilization (capacity factor, annual average)
4208  pUtilizationTechFuel(z, tech, f, y)$(pCapacityTechFuel(z, tech, f, y)) =
4209    pEnergyTechFuel(z, tech, f, y)
4210    / (pCapacityTechFuel(z, tech, f, y) * sum((q, d, t), pHours(q, d, t)))
4211    * 1000;
4212   
4213  * Country-level fuel utilization (capacity factor, annual average)
4214  pUtilizationFuelCountry(c, f, y)$(pCapacityFuelCountry(c, f, y)) =
4215    pEnergyFuelCountry(c, f, y)
4216    / (pCapacityFuelCountry(c, f, y) * sum((q, d, t), pHours(q, d, t)))
4217    * 1000;
4218   
4219  * Country-level technology-fuel utilization (capacity factor, annual average)
4220  pUtilizationTechFuelCountry(c, tech, f, y)$(pCapacityTechFuelCountry(c, tech, f, y)) =
4221    pEnergyTechFuelCountry(c, tech, f, y)
4222    / (pCapacityTechFuelCountry(c, tech, f, y) * sum((q, d, t), pHours(q, d, t)))
4223    * 1000;
4224   
4225   
4226  * ---------------------------------------------------------
4227  * Energy balance [GWh] by zone and country
4228  * ---------------------------------------------------------
4229  * Accounts for demand (electricity and H2), production,
4230  * unmet demand, surplus generation, imports/exports,
4231  * and net interchange, with aggregation to country level.
4232  * ---------------------------------------------------------
4233   
4234  pEnergyBalance(z, "Demand: GWh", y) =
4235    sum((q, d, t), pDemandData(z, q, d, y, t) * pHours(q, d, t) * pEnergyEfficiencyFactor(z, y)) / 1e3;
4236   
4237  pEnergyBalance(z, "Demand H2: GWh", y) =
4238    (sum((h2zmap(hh, z), q, d, t), vH2PwrIn.l(hh, q, d, t, y) * pHours(q, d, t)) / 1e3) $ (fEnableH2Production + 1e-6);
4239   
4240  pEnergyBalance(z, "Total Demand: GWh", y) =
4241    pEnergyBalance(z, "Demand: GWh", y) + pEnergyBalance(z, "Demand H2: GWh", y);
4242   
4243  pEnergyBalance(z, "Total production: GWh", y) =
4244    sum(gzmap(g, z), pEnergyPlant(z, g, y));
4245   
4246  pEnergyBalance(z, "Unmet demand: GWh", y) =
4247    sum((q, d, t), vUSE.l(z, q, d, t, y) * pHours(q, d, t)) / 1e3;
4248   
4249  pEnergyBalance(z, "Surplus generation: GWh", y) =
4250    sum((q, d, t), vSurplus.l(z, q, d, t, y) * pHours(q, d, t)) / 1e3;
4251   
4252  pEnergyBalance(z, "Imports exchange: GWh", y) =
4253    (sum((sTopology(z, z2), q, d, t), vFlow.l(z2, z, q, d, t, y) * pHours(q, d, t))
4254     + sum((zext, q, d, t), vYearlyImportExternal.l(z, zext, q, d, t, y) * pHours(q, d, t))) / 1e3;
4255   
4256  pEnergyBalance(z, "Exports exchange: GWh", y) =
4257    (sum((sTopology(z, z2), q, d, t), vFlow.l(z, z2, q, d, t, y) * pHours(q, d, t))
4258     + sum((zext, q, d, t), vYearlyExportExternal.l(z, zext, q, d, t, y) * pHours(q, d, t))) / 1e3;
4259   
4260  pEnergyBalance(z, "Net interchange: GWh", y) =
4261    pEnergyBalance(z, "Imports exchange: GWh", y) - pEnergyBalance(z, "Exports exchange: GWh", y);
4262   
4263  pEnergyBalance(z, "Net interchange Ratio: GWh", y) $ pEnergyBalance(z, "Demand: GWh", y) =
4264    pEnergyBalance(z, "Net interchange: GWh", y) / pEnergyBalance(z, "Demand: GWh", y);
4265   
4266  pEnergyBalanceCountry(c,dshdr,y) = sum(z$(zcmap(z,c)), pEnergyBalance(z,dshdr,y));
4267   
4268   
4269  *--- H2 Demand-Supply Balance
4270  pEnergyBalanceH2(z,"Demand H2: GWh",y)   =(sum( (h2zmap(hh,z), q,d,t), vH2PwrIn.l(hh,q,d,t,y)*pHours(q,d,t))/1000)$fEnableH2Production+1e-6;
4271  pEnergyBalanceH2(z,"Production H2: mmBTU",           y)        =sum( (h2zmap(hh,z), q,d,t), vH2PwrIn.l(hh,q,d,t,y)*pHours(q,d,t)*pH2Data(hh,"HeatRate"))$fEnableH2Production+1e-6;
4272  pEnergyBalanceH2(z,"External Demand H2: mmBTU",         y)        =sum(q,pExternalH2(z,q,y)       )$fEnableH2Production+1e-6;
4273  pEnergyBalanceH2(z,"Unmet External Demand H2: mmBTU",   y)        =sum(q,vUnmetExternalH2.l(z,q,y))$fEnableH2Production+1e-6;
4274  pEnergyBalanceH2(z,"H2 Power: mmBTU",       y)        =sum(q,vFuelH2Quarter.l(z,q,y)  )$fEnableH2Production+1e-6;
4275   
4276  pEnergyBalanceCountryH2(c,dsH2hdr,y) = sum(z$(zcmap(z,c)), pEnergyBalanceH2(z,dsH2hdr,y));
4277   
4278  * ============================================================
4279  * 4. ENERGY DISPATCH
4280  * ============================================================
4281   
4282  * ---------------------------------------------------------
4283  * Hourly dispatch reporting: plant, fuel, and zone level
4284  * ---------------------------------------------------------
4285  * - pDispatchPlant: plant-level hourly generation and reserve [MW]
4286  * - pDispatchFuel: fuel-level hourly generation [MW]
4287  * - pDispatch: zone-level hourly imports, exports, unmet demand, storage charge, and demand [MW]
4288  * ---------------------------------------------------------
4289   
4290  pDispatchPlant(z, y, q, d, g, t, "Generation")$zgmap(z, g) = sum(gfmap(g, f), vPwrOut.l(g, f, q, d, t, y));
4291  pDispatchPlant(z, y, q, d, g, t, "Reserve")$zgmap(z, g) = vSpinningReserve.l(g, q, d, t, y);
4292   
4293  pDispatchFuel(z, y, q, d, f, t) = sum((gzmap(g, z), gfmap(g, f)), vPwrOut.l(g, f, q, d, t, y));
4294  pDispatchTechFuel(z, y, q, d, tech, f, t) =
4295    sum((gzmap(g, z), gtechmap(g, tech), gfmap(g, f)), vPwrOut.l(g, f, q, d, t, y));
4296   
4297  pDispatch(z, y, q, d, "Imports", t) = sum(sTopology(z, z2), vFlow.l(z2, z, q, d, t, y)) + sum(zext, vYearlyImportExternal.l(z, zext, q, d, t, y));
4298  pDispatch(z, y, q, d, "Exports", t) = -sum(sTopology(z, z2), vFlow.l(z, z2, q, d, t, y)) - sum(zext, vYearlyExportExternal.l(z, zext, q, d, t, y));
4299  pDispatch(z, y, q, d, "Unmet demand", t) = vUSE.l(z, q, d, t, y);
4300  pDispatch(z, y, q, d, "Storage Charge", t) = -sum(zgmap(z, st), vStorInj.l(st, q, d, t, y));
4301  pDispatch(z, y, q, d, "Demand", t) = pDemandData(z, q, d, y, t) * pEnergyEfficiencyFactor(z, y);
4302   
4303  * ============================================================
4304  * 5. RESERVES
4305  * ============================================================
4306   
4307  * ---------------------------------------------------------
4308  * Spinning reserve and reserve margin reporting
4309  * ---------------------------------------------------------
4310  * - pReserveSpinningPlantZone: annual spinning reserve provided by plant and zone [GWh]
4311  * - pReserveSpinningFuelZone: annual spinning reserve provided by fuel and zone [GWh]
4312  * - pReserveSpinningPlantCountry: annual spinning reserve provided by plant and country [GWh]
4313  * - pReserveMargin / pReserveMarginCountry: peak demand, total firm capacity, and reserve margin by zone/country
4314  * ---------------------------------------------------------
4315   
4316  pReserveSpinningPlantZone(zgmap(z,g),y) = sum((q,d,t), vSpinningReserve.l(g,q,d,t,y)*pHours(q,d,t))/1e3 ;
4317  pReserveSpinningFuelZone(z,f,y) = sum((gzmap(g,z),gfmap(g,f),q,d,t), vSpinningReserve.l(g,q,d,t,y)*pHours(q,d,t))/1e3 ;
4318  pReserveSpinningTechFuelZone(z,tech,f,y) =
4319    sum((gzmap(g,z),gtechmap(g,tech),gfmap(g,f),q,d,t), vSpinningReserve.l(g,q,d,t,y)*pHours(q,d,t))/1e3 ;
4320  pReserveSpinningPlantCountry(c,g,y)=  sum((zcmap(z,c),zgmap(z,g)), pReserveSpinningPlantZone(z,g,y));
4321  pReserveSpinningTechFuelCountry(c,tech,f,y) =
4322    sum(zcmap(z,c), pReserveSpinningTechFuelZone(z,tech,f,y));
4323   
4324  pReserveMargin(z,"Peak demand: MW",y) = smax((q,d,t), pDemandData(z,q,d,y,t)*pEnergyEfficiencyFactor(z,y));
4325  pReserveMargin(z,"TotalFirmCapacity",y) = sum(zgmap(z,g), pCapacityCredit(g,y)* vCap.l(g,y));
4326  pReserveMargin(z,"ReserveMargin",y)$(pReserveMargin(z,"TotalFirmCapacity",y)) = pReserveMargin(z,"TotalFirmCapacity",y)/pReserveMargin(z,"Peak demand: MW",y)  ;
4327   
4328  pReserveMarginCountry(c,"Peak demand: MW",y) =   pCapacitySummaryCountry(c,"Peak demand: MW"       ,y);
4329  pReserveMarginCountry(c,"TotalFirmCapacity",y) = sum(zcmap(z,c), pReserveMargin(z,"TotalFirmCapacity",y));
4330  pReserveMarginCountry(c,"ReserveMargin",y)$(pReserveMarginCountry(c,"TotalFirmCapacity",y)) = pReserveMarginCountry(c,"TotalFirmCapacity",y)/ pReserveMarginCountry(c,"Peak demand: MW",y)  ;
4331   
4332  * ============================================================
4333  * 6. INTERCONNECTIONS
4334  * ============================================================
4335   
4336  * ---------------------------------------------------------
4337  * Internal zones: interchange, utilization, losses, congestion
4338  * ---------------------------------------------------------
4339  * - pInterchange / pInterchangeCountry: net interchange flow [GWh]
4340  * - pInterconUtilization: utilization of transfer capacity [%]
4341  * - pLossesTransmission / pLossesTransmissionCountry: transmission losses [GWh]
4342  * - isCongested / pCongestionShare: binary indicator and share of time congested
4343  * ---------------------------------------------------------
4344   
4345  * Annual interchange between internal zones [GWh]
4346  pInterchange(sTopology(z, z2), y) =
4347    sum((q, d, t), vFlow.l(z, z2, q, d, t, y) * pHours(q, d, t)) / 1e3;
4348   
4349   
4350  * Utilization of interconnection throughout modeling horizon [%]
4351  pInterconUtilization(sTopology(z, z2), y)$pInterchange(z, z2, y) =
4352    1e3 * pInterchange(z, z2, y)
4353    / sum((q, d, t),
4354      (pTransferLimit(z, z2, q, y)
4355       + vNewTransmissionLine.l(z, z2, y)
4356         * max(pNewTransmission(z, z2, "CapacityPerLine"),
4357           pNewTransmission(z2, z, "CapacityPerLine"))
4358         * fAllowTransferExpansion)
4359      * pHours(q, d, t)
4360      );
4361   
4362  * Transmission losses between internal zones in MWh per zone
4363  pLossesTransmission(z, y) =
4364    sum((sTopology(z, z2), q, d, t),
4365      vFlow.l(z2, z, q, d, t, y) * pLossFactorInternal(z, z2, y) * pHours(q, d, t)
4366    );
4367   
4368  * Country-level interchange and losses
4369  alias (zcmap, zcmap2);
4370   
4371  pInterchangeCountry(c, c2, y) =
4372    sum((zcmap(z, c), zcmap2(z2, c2), sMapConnectedZonesDiffCountries(z2, z)),
4373      pInterchange(z, z2, y)
4374    );
4375   
4376  pLossesTransmissionCountry(c, y) =
4377    sum(zcmap(z, c), pLossesTransmission(z, y));
4378   
4379  * Binary indicator for congestion per time step
4380  isCongested(z, z2, q, d, t, y)$(
4381    sTopology(z, z2)
4382    and abs(
4383      vFlow.l(z, z2, q, d, t, y)
4384      - (
4385        pTransferLimit(z, z2, q, y)
4386        + vNewTransmissionLine.l(z, z2, y)
4387          * max(pNewTransmission(z, z2, "CapacityPerLine"),
4388            pNewTransmission(z2, z, "CapacityPerLine"))
4389          * fAllowTransferExpansion
4390        )
4391      ) < 1e-5
4392  ) = 1;
4393   
4394  * Percentage of time (weighted by pHours) when the line is congested
4395  pCongestionShare(sTopology(z, z2), y) =
4396    sum((q, d, t), isCongested(z, z2, q, d, t, y) * pHours(q, d, t))
4397    / sum((q, d, t), pHours(q, d, t));
4398   
4399   
4400  * ---------------------------------------------------------
4401  * External zones: imports and exports
4402  * ---------------------------------------------------------
4403  * - pHourlyInterchangeExternal / pYearlyInterchangeExternal: hourly and annual imports/exports [GWh]
4404  * - pInterchangeExternalExports / pInterconUtilizationExternalExports: exports and line utilization [%]
4405  * - pInterchangeExternalImports / pInterconUtilizationExternalImports: imports and line utilization [%]
4406  * - pHourlyInterchangeExternalCountry / pYearlyInterchangeExternalCountry: aggregated country-level interchange [GWh]
4407  * ---------------------------------------------------------
4408   
4409  set thrd / Imports, Exports /;
4410  set isExternal / Internal, External /;
4411   
4412  * Hourly interchange with external zones [MW]
4413  pHourlyInterchangeExternal(z, y, q, d, "Imports", t) =
4414    sum(zext, vYearlyImportExternal.l(z, zext, q, d, t, y));
4415   
4416  pHourlyInterchangeExternal(z, y, q, d, "Exports", t) =
4417    sum(zext, vYearlyExportExternal.l(z, zext, q, d, t, y));
4418   
4419  * Annual interchange with external zones [GWh]
4420  pYearlyInterchangeExternal(z, thrd, y) =
4421    sum((q, d, t), pHourlyInterchangeExternal(z, y, q, d, thrd, t) * pHours(q, d, t)) / 1e3;
4422   
4423  * Annual exports and imports with external zones [GWh]
4424  pInterchangeExternalExports(z, zext, y) =
4425    sum((q, d, t), vYearlyExportExternal.l(z, zext, q, d, t, y) * pHours(q, d, t)) / 1e3;
4426   
4427  pInterchangeExternalImports(zext, z, y) =
4428    sum((q, d, t), vYearlyImportExternal.l(z, zext, q, d, t, y) * pHours(q, d, t)) / 1e3;
4429   
4430  * Utilization of external interconnections [%]
4431  pInterconUtilizationExternalExports(z, zext, y)$pInterchangeExternalExports(z, zext, y) =
4432    1e3 * pInterchangeExternalExports(z, zext, y)
4433    / sum((q, d, t), pExtTransferLimitOut(z, zext, q, y) * pHours(q, d, t));
4434   
4435  pInterconUtilizationExternalImports(zext, z, y)$pInterchangeExternalImports(zext, z, y) =
4436    1e3 * pInterchangeExternalImports(zext, z, y)
4437    / sum((q, d, t), pExtTransferLimitIn(z, zext, q, y) * pHours(q, d, t));
4438   
4439  * Country-level hourly and annual interchange with external zones
4440  pHourlyInterchangeExternalCountry(c, y, q, d, thrd, t) =
4441    sum(zcmap(z, c), pHourlyInterchangeExternal(z, y, q, d, thrd, t));
4442   
4443  pYearlyInterchangeExternalCountry(c, thrd, y) =
4444    sum(zcmap(z, c), pYearlyInterchangeExternal(z, thrd, y));
4445   
4446  * ---------------------------------------------------------
4447  * Net import by zone and source zone type
4448  * ---------------------------------------------------------
4449  * Calculates net import (imports - exports) for each zone from
4450  * every other zone, distinguishing between internal and external zones.
4451  * Positive values indicate net imports, negative values indicate net exports.
4452  * ---------------------------------------------------------
4453   
4454  * Net import from internal zones
4455  * pInterchange(z, z2, y) represents flow from z to z2
4456  * Net import from z2 to z = -pInterchange(z, z2, y) when sTopology(z, z2) exists
4457  * If only reverse direction exists, use pInterchange(z2, z, y) directly
4458  pNetImport(z, z2, y, "Internal")$sTopology(z, z2) = -pInterchange(z, z2, y) / 1e3;
4459  pNetImport(z, z2, y, "Internal")$(sTopology(z2, z) and not sTopology(z, z2)) = pInterchange(z2, z, y) / 1e3;
4460   
4461  * Net import from external zones
4462  * Net import from zext to z = imports from zext - exports to zext
4463  pNetImport(z, zext, y, "External") =
4464    pInterchangeExternalImports(zext, z, y) - pInterchangeExternalExports(z, zext, y) / 1e3;
4465   
4466  * ============================================================
4467  * 7. EMISSIONS
4468  * ============================================================
4469   
4470  * ---------------------------------------------------------
4471  * Emissions reporting: zone, country, and marginal costs
4472  * ---------------------------------------------------------
4473  * - pEmissionsZone: total CO2 emissions [Mt] by zone and year
4474  * - pEmissionsIntensityZone: CO2 intensity [tCO2/GWh] by zone and year
4475  * - pEmissionsCountrySummary: total and backstop CO2 emissions [Mt] by country and year
4476  * - pEmissionsIntensityCountry: CO2 intensity [tCO2/GWh] by country and year
4477  * - pEmissionMarginalCosts / pEmissionMarginalCostsCountry: marginal cost of emission constraints [USD/tCO2]
4478  * ---------------------------------------------------------
4479   
4480  pEmissionsZone(z,y)                                                     =  vZonalEmissions.l(z,y)/1e6 ;
4481  pEmissionsIntensityZone(z,y)$pEnergyBalance(z,"Total production: GWh",y) = 1e-3*pEmissionsZone(z,y)/pEnergyBalance(z,"Total production: GWh",y);
4482  pEmissionsCountrySummary(c,"Emissions: mm tCO2eq",y)                               = sum(zcmap(z,c), pEmissionsZone(z,y));
4483  pEmissionsCountrySummary(c,"CO2backstopEmissions: mm tCO2eq",y)                    = vYearlyCO2backstop.l(c,y)/1e6;
4484  pEmissionsIntensityCountry(c,y)$pEnergyBalanceCountry(c,"Total production: GWh",y) = 1e-3*sum(zcmap(z,c), vZonalEmissions.l(z,y))/pEnergyBalanceCountry(c,"Total production: GWh",y);
4485   
4486  pEmissionMarginalCosts(y) $(pWeightYear(y))                  = -eTotalEmissionsConstraint.M(y)/pRR(y)/pWeightYear(y);
4487  pEmissionMarginalCostsCountry(c,y) $(pWeightYear(y))         = -eEmissionsCountry.M(c,y)/pRR(y)/pWeightYear(y);
4488   
4489  * ============================================================
4490  * 8. PRICES
4491  * ============================================================
4492  * ---------------------------------------------------------
4493  * Average yearly electricity prices at zone and country level
4494  * ---------------------------------------------------------
4495  * Calculates demand-weighted consumer prices, export/import
4496  * prices weighted by actual flows (internal & external),
4497  * and hub prices. Aggregates results to country averages
4498  * using zonal weights and interconnection flows.
4499  * ---------------------------------------------------------
4500   
4501  * Average yearly price paid by consumers, weighted by demand
4502  pPrice(z,y)$pEnergyBalance(z,"Demand: GWh",y) = 1e-3*sum((q,d,t),pHourlyPrice(z,q,d,t,y)*pDemandData(z,q,d,y,t)*pHours(q,d,t)*pEnergyEfficiencyFactor(z,y))
4503                                                       /pEnergyBalance(z,"Demand: GWh",y) ;
4504   
4505  Parameter
4506    pFlowMWSum(z,z2,y)    "Sum of hourly MW flows over the year (used for weights)"
4507    pFlowMWh(z,z2,y)      "Annual energy flow between zones [MWh]"
4508  ;
4509   
4510  pFlowMWSum(z,z2,y) = sum(sFlow(z,z2,q,d,t,y),vFlow.l(z,z2,q,d,t,y));
4511  pFlowMWh(z,z2,y) = sum(sFlow(z,z2,q,d,t,y),vFlow.l(z,z2,q,d,t,y)*pHours(q,d,t));
4512   
4513  * Average price of exports and imports, weighted by actual flows on the lines
4514  pPriceExport(z,y) $(sum(Zd, pFlowMWh(z,Zd,y))  > 0) = (sum((sTopology(z,Zd),q,d,t),  pHourlyPrice(z,q,d,t,y) *vFlow.l(z,Zd,q,d,t,y)*pHours(q,d,t))
4515                                                             + sum((zext,q,d,t), vYearlyExportExternal.l(z,zext,q,d,t,y) * pTradePrice(zext,q,d,y,t) * pHours(q,d,t)))
4516                                                           /(sum(Zd, pFlowMWh(z,Zd,y))+ sum((zext,q,d,t), vYearlyExportExternal.l(z,zext,q,d,t,y)* pHours(q,d,t)));
4517   
4518  pPriceImport(z,y) $(sum(Zd, pFlowMWh(Zd,z,y))  > 0) = (sum((sTopology(Zd,z),q,d,t),  pHourlyPrice(Zd,q,d,t,y)*vFlow.l(Zd,z,q,d,t,y)*pHours(q,d,t))
4519                                                              + sum((zext,q,d,t), vYearlyImportExternal.l(z,zext,q,d,t,y) * pTradePrice(zext,q,d,y,t) * pHours(q,d,t)))
4520                                                           /(sum(Zd, pFlowMWh(Zd,z,y))+ sum((zext,q,d,t), vYearlyImportExternal.l(z,zext,q,d,t,y)  * pHours(q,d,t)));
4521   
4522  * Average price at the hub, weighted by actual flows on the lines (TODO: check not with pHours)
4523  pPriceHub(Zt,y)$(sum(Zd, pFlowMWSum(Zt,Zd,y))   > 0) = sum((sTopology(Zt,Zd),q,d,t), pHourlyPrice(Zt,q,d,t,y)*vFlow.l(Zt,Zd,q,d,t,y))
4524                                                           /sum(Zd, pFlowMWSum(Zt,Zd,y));
4525   
4526  * Average yearly price paid by consumers, weighted by demand
4527  pPriceCountry(c,y)$pEnergyBalanceCountry(c,"Demand: GWh",y) = sum(zcmap(z,c), pPrice(z,y)*pEnergyBalance(z,"Demand: GWh",y))/pEnergyBalanceCountry(c,"Demand: GWh",y);
4528   
4529  * ---------------------------------------------------------
4530  * Country-level interconnection energy flows [MWh]
4531  * ---------------------------------------------------------
4532  * Aggregated annual energy exchanged between a country and its
4533  * neighboring countries, used as weights to compute average
4534  * export and import prices:
4535  *   - pCountryExportFlowMWh: total export energy from country c
4536  *   - pCountryImportFlowMWh: total import energy into country c
4537  * ---------------------------------------------------------
4538   
4539  Parameter
4540      pCountryExportFlowMWh(c,y) "Annual exported energy [MWh] from country c"
4541      pCountryImportFlowMWh(c,y) "Annual imported energy [MWh] into country c";
4542   
4543  pCountryExportFlowMWh(c,y) = sum((zcmap(z,c), sMapConnectedZonesDiffCountries(z,Zd)), pFlowMWh(z,Zd,y));
4544   
4545  pPriceExportCountry(c,y)$(pCountryExportFlowMWh(c,y) > 0) =
4546      sum((zcmap(z,c), sMapConnectedZonesDiffCountries(z,Zd),q,d,t),
4547          pHourlyPrice(z,q,d,t,y)*vFlow.l(z,Zd,q,d,t,y)*pHours(q,d,t))
4548      / pCountryExportFlowMWh(c,y);
4549   
4550  pCountryImportFlowMWh(c,y) = sum((zcmap(z,c), sMapConnectedZonesDiffCountries(Zd,z)), pFlowMWh(Zd,z,y));
4551   
4552  pPriceImportCountry(c,y)$(pCountryImportFlowMWh(c,y) > 0) =
4553      sum((zcmap(z,c), sMapConnectedZonesDiffCountries(Zd,z),q,d,t),
4554          pHourlyPrice(Zd,q,d,t,y)*vFlow.l(Zd,z,q,d,t,y)*pHours(q,d,t))
4555      / pCountryImportFlowMWh(c,y);
4556   
4557   
4558   
4559  * ============================================================
4560  * 9. SPECIAL TECHNOLOGIES
4561  * ============================================================
4562  * ---------------------------------------------------------
4563  * CSP, PV+Storage, and Generic Storage balances and components
4564  * ---------------------------------------------------------
4565  * Tracks technology-specific balances and installed components:
4566  *   - pCSPBalance: thermal, storage input/output, and power output by CSP
4567  *   - pCSPComponents: thermal field, storage, power block, solar multiple, storage hours
4568  *   - pPVwSTOBalance: PV output, storage input/output, storage losses and levels for PV+storage systems
4569  *   - pPVwSTOComponents: PV capacity, storage MW/MWh, storage hours
4570  *   - pStorageBalance: input, output, losses, net change, and storage level for generic storage
4571  *   - pStorageComponents: installed MW, MWh, and storage hours
4572  * ---------------------------------------------------------
4573   
4574  pCSPBalance(y, g,q,d,"Thermal output",t) = vThermalOut.l(g,q,d,t,y);
4575  pCSPBalance(y,cs,q,d,"Storage Input" ,t) = vStorInj.l(cs,q,d,t,y);
4576  pCSPBalance(y,cs,q,d,"Storage Output",t) = vStorOut.l(cs,q,d,t,y);
4577  pCSPBalance(y,cs,q,d,"Power Output"  ,t) = sum(gfmap(cs,f), vPwrOut.l(cs,f,q,d,t,y));
4578   
4579  pCSPComponents(g, "Thermal Field: WM" ,y) = vCapTherm.l(g,y);
4580  pCSPComponents(cs,"Storage: MWh"      ,y) = vCapStor.l(cs,y);
4581  pCSPComponents(cs,"Power Block: MW"   ,y) = vCap.l(cs,y);
4582  pCSPComponents(g, "Solar Multiple"    ,y) = vCapTherm.l(g,y)/max(vCap.l(g,y),1);
4583  pCSPComponents(cs,"Storage Hours: hrs",y) = vCapStor.l(cs,y)/max(vCap.l(cs,y),1);
4584   
4585  pPVwSTOBalance(y,q,d,so, "PV output"     ,t) = sum(gfmap(so,f), vPwrOut.l(so,f,q,d,t,y));
4586  pPVwSTOBalance(y,q,d,stp,"Storage Input" ,t) = vStorInj.l(stp,q,d,t,y);
4587  pPVwSTOBalance(y,q,d,stp,"Storage output",t) = sum(gfmap(stp,f), vPwrOut.l(stp,f,q,d,t,y));
4588  pPVwSTOBalance(y,q,d,stp,"Storage Losses",t) = (1-pStorageData(stp,"Efficiency"))*vStorInj.l(stp,q,d,t,y);
4589  pPVwSTOBalance(y,q,d,stp,"Storage level" ,t) = vStorage.l(stp,q,d,t,y);
4590   
4591  pPVwSTOComponents(so, "PV Plants"           ,y) = vCap.l(so,y);
4592  pPVwSTOComponents(stp,"Storage Capacity MW" ,y) = vCap.l(stp,y);
4593  pPVwSTOComponents(stp,"Storage Capacity MWh",y) = vCapStor.l(stp,y);
4594  pPVwSTOComponents(stp,"Storage Hours"       ,y) = vCapStor.l(stp,y)/max(vCap.l(stp,y),1);
4595   
4596  pStorageBalance(y,stg,q,d,"Storage Input"     ,t) = vStorInj.l(stg,q,d,t,y);
4597  pStorageBalance(y,stg,q,d,"Storage Output"    ,t) = sum(gfmap(stg,f), vPwrOut.l(stg,f,q,d,t,y));
4598  pStorageBalance(y,stg,q,d,"Storage Losses"    ,t) = (1-pStorageData(stg,"Efficiency"))*vStorInj.l(stg,q,d,t,y);
4599  pStorageBalance(y,stg,q,d,"Net Storage Change",t) = vStorNet.l(stg,q,d,t,y);
4600  pStorageBalance(y,stg,q,d,"Storage Level"     ,t) = vStorage.l(stg,q,d,t,y);
4601   
4602  pStorageComponents(stg,"Storage Capacity: MW",y) = vCap.l(stg,y);
4603  pStorageComponents(stg,"Storage Capacity: MWh"  ,y) = vCapStor.l(stg,y);
4604  pStorageComponents(stg,"Storage Hours"         ,y) = vCapStor.l(stg,y)/max(vCap.l(stg,y),1);
4605   
4606  * ---------------------------------------------------------
4607  * Zonal solar energy, value, and cost indicators
4608  * ---------------------------------------------------------
4609  * Computes solar power output, annual energy, market value,
4610  * and levelized cost of solar at the zonal level:
4611  *   - pSolarPower: hourly solar generation
4612  *   - pSolarEnergyZone: total annual solar energy (MWh)
4613  *   - pSolarValueZone: average market value of solar ($/MWh)
4614  *   - pSolarCost: levelized cost of solar based on Investment costs ($/MWh)
4615  * ---------------------------------------------------------
4616   
4617  set PVtech(tech) / PV, PVwSTO /;
4618  Parameter pSolarEnergyZone(z,y);
4619   
4620  pSolarPower(z,q,d,t,y) = sum((gzmap(g,z),gtechmap(g,PVtech),gfmap(g,f)), vPwrOut.l(g,f,q,d,t,y));
4621  pSolarEnergyZone(z,y) = sum((q,d,t), pSolarPower(z,q,d,t,y)*pHours(q,d,t));
4622  pSolarValueZone(z,y)$(pSolarEnergyZone(z,y) > 0) = sum((q,d,t), pHourlyPrice(z,q,d,t,y)*pSolarPower(z,q,d,t,y))/pSolarEnergyZone(z,y);
4623  pSolarCost(z,y)$(pSolarEnergyZone(z,y) > 0) = (sum((gzmap(ng,z),gtechmap(ng,PVtech)), pCRF(ng)*vCap.l(ng,y)*pGenData(ng,"Capex")*pCapexTrajectories(ng,y))*1e6)/pSolarEnergyZone(z,y);
4624   
4625   
4626  * ============================================================
4627  * 10. METRICS
4628  * ============================================================
4629   
4630  * ---------------------------------------------------------
4631  * LCOE by plant [$/MWh]
4632  * ---------------------------------------------------------
4633   
4634  Parameter
4635    pPlantEnergyMWh(z,g,y) "Annual energy production by plant [MWh]"
4636  ;
4637   
4638  * Plant-level energy denominator
4639  pPlantEnergyMWh(z,g,y)$pEnergyPlant(z,g,y) = pEnergyPlant(z,g,y)*1e3;
4640   
4641  * LCOE for new capacity plants (without direct spinning reserve cost)
4642  pPlantAnnualLCOE(z,g,y)$((pPlantEnergyMWh(z,g,y)) and (pPlantEnergyMWh(z,g,y) >= 1e3)) =
4643      1e6 * (
4644          pCostsPlant(z, g, "Investment costs: $m", y)
4645        + pCostsPlant(z, g, "Fixed O&M: $m", y)
4646        + pCostsPlant(z, g, "Variable Cost: $m", y)
4647  *      + pCostsPlant(z, g, "Spinning Reserve Cost: $m", y)
4648      ) / pPlantEnergyMWh(z,g,y);
4649   
4650   
4651  * Zone-level generation cost intensity by component [$/MWh]
4652  pGenCostsPerMWh(z,genCostCmp,y)$sum(gzmap(g,z), pEnergyPlant(z,g,y)) =
4653      1e6 * sum(gzmap(g,z), pCostsPlant(z, g, genCostCmp, y))
4654      / (sum(gzmap(g,z), pEnergyPlant(z,g,y)) * 1e3);
4655   
4656   
4657  * ============================================================
4658  * 11. modeltype PARAMETERS
4659  * ============================================================
4660   
4661  pSolverParameters("modeltype Status")               = PA.modelstat + EPS;
4662  pSolverParameters("modeltype Time: ms")             = PA.etSolve + EPS;
4663  pSolverParameters("Absolute gap")                = PA.objVal-PA.objEst + EPS;
4664  pSolverParameters("Relative gap")$(PA.objVal >0) = pSolverParameters("Absolute gap")/PA.objVal + EPS;
4665   
4666  *--- END RESULTS
4667   
