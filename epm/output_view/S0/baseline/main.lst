1239     pGenData(g,pGenDataInputHeader) 'Generator characteristics (capex, heat rate, etc.)'
1240     pAvailability(g,y,q)           'Seasonal availability factors'
1241     pCapexTrajectories(g,y)        'CAPEX trajectory multipliers'
1242     pInitialOnStart(g)             'Initial commitment state (1=on) for the first chronological slot (default or from data)'
