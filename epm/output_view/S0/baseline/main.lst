3585    pCSPComponents(g,*,y)                     'CSP installed components and metrics'
3586    pPVwSTOBalance(y,q,d,g,*,t)               'PV+Storage hourly output by type [MW]'
3587    pPVwSTOComponents(g,*,y)                  'PV+Storage installed components and metrics'
3588    pStorageBalance(y,g,q,d,*,t)              'Generic storage hourly output by type [MW]'
3589    pStorageComponents(g,*,y)                 'Generic storage installed components and metrics'
3590    pSolarValueZone(z,y)                      'Average market value of solar [USD/MWh]'
3591    pSolarCost(z,y)                           'Levelized cost of solar [USD/MWh]'
3592    pSolarPower(z,q,d,t,y)                    'Solar hourly output [MWh]'
