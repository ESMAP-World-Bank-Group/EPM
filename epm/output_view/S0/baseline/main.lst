1245     fEnableExternalExchange          'Permit external exchange'
1246     pMaxAnnualExternalTradeShare(y,c) 'Annual import/export share cap by country'
1247     pTradePrice(zext,q,d,y,t)      'Border price for external trades'
1248     sMaxHourlyImportExternalShare  'Hourly import cap (share of demand)'
1249     sMaxHourlyExportExternalShare  'Hourly export cap (share of demand)'
1250     pExtTransferLimit(z,zext,q,*,y) 'Full external transfer limit tensor'
