1252     pExtTransferLimitOut(z,zext,q,y)'Export limit (duplicate of earlier parameter)'
1253   
1254  * Demand inputs
1255     pDemandData(z,q,d,y,t)         'Demand time series (seasonal, daily, hourly)'
1256   
1257  * Renewable/storage inputs
1258     pCSPProfile(g,q,d,t)           'CSP solar profile (pu)'
1259     pStoPVProfile(g,q,d,t)         'PV-with-storage profile (pu)'
1260     pStorageData(g,pStorageDataHeader)  'Storage technical data'
